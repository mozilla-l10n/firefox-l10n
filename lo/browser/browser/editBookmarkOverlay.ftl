bookmark-overlay-tags-expander2 =
    .tooltiptext = ສະແດງແທັກທັງຫມົດ
bookmark-overlay-tags-expander-hide =
    .tooltiptext = ເຊື່ອງ
bookmark-overlay-keyword-2 =
    .value = ຄໍາທີ່ຕ້ອງການຊອກຫາ
