## Default button labels for <dialog> elements

dialog-button-accept =
    .label = OK
dialog-button-cancel =
    .label = ຍົກເລີກ
dialog-button-disclosure =
    .label = ຂໍ້ມູນເພີ່ມເຕີມ
    .accesskey = I

## Predefined button labels for dialogs created with nsIPrompt.confirmEx()

dialog-button-yes =
    .label = ແມ່ນແລ້ວ
    .accesskey = ແ
dialog-button-no =
    .label = ບໍ່ແມ່ນ
    .accesskey = ບ
dialog-button-save =
    .label = ບັນທຶກ
    .accesskey = ບ
dialog-button-dont-save =
    .label = ບໍ່ບັນທຶກ
    .accesskey = n
dialog-button-revert =
    .label = ປີ້ນຄືນ
    .accesskey = ປ
