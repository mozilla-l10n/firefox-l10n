### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

# Displayed in place of the font URL when the font is installed locally on the
# system.
font-inspector-system = מערכת
font-inspector-no-fonts-used = לא נעשה שימוש בגופנים ברכיב הנוכחי.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = העתקת כתובת
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = מופע
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = התאמה אישית

## Labels for the font editor controls

font-inspector-font-size-label = גודל
font-inspector-font-weight-label = משקל
font-inspector-font-italic-label = נטוי
font-inspector-letter-spacing-label = ריווח
font-inspector-line-height-label = גובה שורה

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = הצגת עוד
font-inspector-show-less = הצגת פחות

##

font-inspector-all-fonts-on-page-header = כל הגופנים בעמוד
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = גופנים בשימוש
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = טקסט תצוגה מקדימה של גופן

## Labels for font metadata, displayed in the "All Fonts on Page" section.

font-inspector-font-version = גרסה:
font-inspector-font-designer = מעצב:
font-inspector-font-manufacturer = יצרן:
font-inspector-font-vendor = ספק:
font-inspector-font-description = תיאור:
font-inspector-font-license = רישיון:
font-inspector-font-license-info-url = כתובת אתר של פרטי הרישיון:

##

# Button displayed to expand a truncated value (e.g. Description or License).
font-inspector-show-full-text = הרחבה
