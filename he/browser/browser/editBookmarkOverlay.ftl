bookmark-properties-title-add-folder = הוספת תיקיית סימניות
bookmark-properties-title-edit-bookmark = עריכת סימנייה
bookmark-properties-title-edit-folder = עריכת תיקיית סימניות

## Default names for newly created bookmarks and folders.

# Default name of the folder created when bookmarking all tabs.
bookmark-properties-default-name-all-tabs-folder = [שם תיקייה]
bookmark-properties-default-name-folder = תיקייה חדשה
bookmark-properties-default-name-bookmark = סימנייה חדשה
