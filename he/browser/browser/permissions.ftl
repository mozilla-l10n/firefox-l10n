perm-persistent-storage-remember = לזכור בחירה זו
speech-recognition-model-download-header = להגדיר זיהוי דיבור?
# $sizeMB (Number) - the model download size in MB.
speech-recognition-model-download-message = ‏{ -brand-short-name } מפעיל זיהוי דיבור באופן מקומי, כך שהאודיו לעולם לא עוזב את המכשיר שלך. כדי להגדיר את זה, הורדה של כ־{ $sizeMB } מ״ב עם המשך התהליך.
speech-recognition-model-download-allow =
    .label = המשך
    .accesskey = ה
speech-recognition-model-download-not-now =
    .label = לא כעת
    .accesskey = ל
speech-recognition-model-download-progress-message = בתהליך הורדת מודל לזיהוי דיבור
# Accessible name of the progress bar shown while the model downloads. The
# percentage and time remaining are rendered next to it, as text.
speech-recognition-model-download-progressbar =
    .aria-label = התקדמות הורדת המודל לזיהוי דיבור
speech-recognition-model-download-cancel =
    .label = ביטול
    .accesskey = ב
speech-recognition-model-download-complete-message = המודל לזיהוי דיבור הורד.
speech-recognition-model-download-failed-message = הורדת המודל לזיהוי דיבור נכשלה.
speech-recognition-model-download-ok =
    .label = אישור
    .accesskey = א
