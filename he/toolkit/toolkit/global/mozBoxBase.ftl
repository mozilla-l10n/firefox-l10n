moz-box-link-anchor =
    .title = פותח בלשונית חדשה
moz-box-link-opens-in-new-tab = פותח בלשונית חדשה
moz-box-item-reorder-handle =
    .aria-label = סידור מחדש של פריטים באמצעות Ctrl+Shift+ArrowUp או Ctrl+Shift+ArrowDown
# Variables:
#   $item (string) - The label of the moz-box-item being reordered.
moz-box-item-reorder-handle-named =
    .aria-label = סידור מחדש של { $item } באמצעות Ctrl+Shift+ArrowUp או Ctrl+Shift+ArrowDown

## Screen reader announcements made after an item in a reorderable list is moved.
## Variables:
##   $position (number) - The new position of the item in the list, starting at 1.
##   $total (number) - The total number of items in the list.

moz-box-group-reorder-announcement = הפריט הועבר למיקום { $position } מתוך { $total }
