perm-persistent-storage-remember = Запомнить это решение
speech-recognition-model-download-header = Настроить распознавание речи?
# $sizeMB (Number) - the model download size in MB.
speech-recognition-model-download-message = { -brand-short-name } запускает распознавание речи локально, поэтому звук никогда не покидает ваше устройство. Чтобы настроить это, когда вы продолжите, начнётся загрузка ~{ $sizeMB } МБ.
speech-recognition-model-download-allow =
    .label = Продолжить
    .accesskey = П
speech-recognition-model-download-not-now =
    .label = Не сейчас
    .accesskey = Н
speech-recognition-model-download-progress-message = Скачивание модели распознавания речи
# Accessible name of the progress bar shown while the model downloads. The
# percentage and time remaining are rendered next to it, as text.
speech-recognition-model-download-progressbar =
    .aria-label = Прогресс скачивания модели распознавания речи
speech-recognition-model-download-cancel =
    .label = Отмена
    .accesskey = О
speech-recognition-model-download-complete-message = Модель распознавания речи загружена.
speech-recognition-model-download-failed-message = Ошибка загрузки модели распознавания речи.
speech-recognition-model-download-ok =
    .label = OK
    .accesskey = Щ
