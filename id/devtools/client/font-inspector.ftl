### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

font-inspector-no-fonts-used = Tidak ada fon yang digunakan untuk elemen saat ini.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = Salin URL
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Instansi
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Ubahsuaian

## Labels for the font editor controls

font-inspector-font-size-label = Ukuran
font-inspector-font-weight-label = Berat
font-inspector-font-italic-label = Miring
font-inspector-line-height-label = Tinggi Baris

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Lebih banyak
font-inspector-show-less = Lebih sedikit

##

font-inspector-all-fonts-on-page-header = Seluruh jenis huruf pada laman
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Fon yang Digunakan
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Teks pratinjau fon

