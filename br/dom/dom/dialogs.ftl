## Unresponsive script dialog

# The & character marks the access key of the checkbox label.
dom-slow-script-dialog-dont-ask-again = &Na c'houlenn diganin en-dro
dom-slow-script-dialog-stop-button = Arsaviñ ar skript
dom-slow-script-dialog-continue-button = Kenderc'hel ganti
# Variables:
#   $extensionName (String) - Name of the extension running the script.
dom-slow-addon-script-dialog-message =
    Ur skript eus an askouezh “{ $extensionName }” a zo lañset war ar bajenn-mañ, ha lakaat a ra { -brand-short-name } da vezañ anrespontus.
    
    Gallout a ra bezañ ac'hubet, pe marteze en deus paouezet da respont penn-da-benn. Gallout a rit herzel ar skript bremañ, pe gallout a rit kenderc'hel ha gwelet ma vo echuet.
dom-slow-addon-script-dialog-checkbox = Mirout ar skript anrespontus da vezañ lañset war ar bajenn-mañ a-raok ma vefe adkarget.
