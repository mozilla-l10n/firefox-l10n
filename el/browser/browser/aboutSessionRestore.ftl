restore-page-tab-title = Ανάκτηση συνεδρίας
# The title is intended to be apologetic and disarming, expressing dismay
# and regret that we are unable to restore the session for the user
restore-page-error-title = Δυστυχώς, προέκυψε πρόβλημα με την ανάκτηση των σελίδων σας.
restore-page-problem-desc = Υπάρχει ένα πρόβλημα με την ανάκτηση της τελευταίας σας συνεδρίας περιήγησης. Επιλέξτε «Ανάκτηση συνεδρίας» για να δοκιμάσετε ξανά.
restore-page-try-this = Εξακολουθείτε να μην μπορείτε να ανακτήσετε τη συνεδρία σας; Μερικές φορές, το ζήτημα οφείλεται σε κάποια καρτέλα. Δείτε τις προηγούμενες καρτέλες, καταργήστε την επιλογή των καρτελών που δεν χρειάζεται να επαναφέρετε και έπειτα, κάντε ανάκτηση.
restore-page-hide-tabs = Απόκρυψη προηγούμενων καρτελών
restore-page-show-tabs = Προβολή προηγούμενων καρτελών
# When tabs are distributed across multiple windows, this message is used as a
# header above the group of tabs for each window.
#
# Variables:
#    $windowNumber: Progressive number associated to each window
restore-page-window-label = Παράθυρο { $windowNumber }
restore-page-restore-header =
    .label = Ανάκτηση
restore-page-list-header =
    .label = Παράθυρα και καρτέλες
restore-page-try-again-button =
    .label = Ανάκτηση συνεδρίας
    .accesskey = ρ
restore-page-close-button =
    .label = Έναρξη νέας συνεδρίας
    .accesskey = ν

## The following strings are used in about:welcomeback

welcome-back-tab-title = Επιτυχία!
welcome-back-page-title = Επιτυχία!
welcome-back-page-info = Το { -brand-short-name } είναι έτοιμο.
welcome-back-restore-button =
    .label = Φύγαμε!
    .accesskey = Φ
welcome-back-restore-all-label = Ανάκτηση όλων των παραθύρων και των καρτελών
welcome-back-restore-some-label = Ανάκτηση μόνο των επιθυμητών
welcome-back-page-info-link = Τα πρόσθετα και οι προσαρμογές σας καταργήθηκαν και έγινε επαναφορά στις προεπιλεγμένες ρυθμίσεις του προγράμματος περιήγησής σας. Εάν αυτό δεν διόρθωσε το πρόβλημα, <a data-l10n-name="link-more">μάθετε περισσότερα σχετικά με τις διαθέσιμες επιλογές σας.</a>
