## Lock screen covering Private Windows after the computer locks, goes to
## sleep or starts the screen saver, or after the user presses the shortcut to
## lock windows.

window-lock-private-title = Τα ιδιωτικά παράθυρα είναι κλειδωμένα
window-lock-private-description-macos = Το { -brand-short-name } αποκρύπτει τις ιδιωτικές σας σελίδες όταν ο υπολογιστής σας κλειδώσει, τεθεί σε αναστολή λειτουργίας ή ενεργοποιηθεί η προφύλαξη οθόνης.
window-lock-private-description-windows = Το { -brand-short-name } αποκρύπτει τις ιδιωτικές σας σελίδες όταν κλειδώνει ο υπολογιστής σας.
window-lock-unlock-button =
    .label = Ξεκλείδωμα
# Shown on the lock screen when the operating system authentication prompt failed with an error.
window-lock-auth-error =
    .message = Δεν ήταν δυνατή η επαλήθευση της ταυτότητάς σας. Δοκιμάστε ξανά.
# Title of the Windows authentication prompt when unlocking browser windows.
window-lock-os-auth-dialog-caption = { -brand-full-name }
# This message is shown in the Windows authentication prompt when unlocking Private Windows.
window-lock-private-os-auth-dialog-message-win = Για να ξεκλειδώσετε τα ιδιωτικά παράθυρά σας, εισαγάγετε τα στοιχεία σύνδεσής σας για τα Windows ώστε να επαληθεύσετε την ταυτότητά σας.
# This message is shown in the macOS authentication prompt when unlocking Private Windows.
# On macOS, only provide the reason that account verification is needed. Do not put a complete sentence here
# (the system adds “Firefox is trying to…” before it).
window-lock-private-os-auth-dialog-message-macosx = ξεκλειδώσει τα ιδιωτικά παράθυρά σας
