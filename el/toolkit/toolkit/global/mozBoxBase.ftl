moz-box-link-anchor =
    .title = Ανοίγει σε νέα καρτέλα
moz-box-link-opens-in-new-tab = Ανοίγει σε νέα καρτέλα
moz-box-item-reorder-handle =
    .aria-label = Αναδιατάξτε το στοιχείο με τα Ctrl+Shift+Πάνω βέλος ή τα Ctrl+Shift+Κάτω βέλος
# Variables:
#   $item (string) - The label of the moz-box-item being reordered.
moz-box-item-reorder-handle-named =
    .aria-label = Αναδιατάξτε το στοιχείο «{ $item }» με τα Ctrl+Shift+Πάνω βέλος ή τα Ctrl+Shift+Κάτω βέλος

## Screen reader announcements made after an item in a reorderable list is moved.
## Variables:
##   $position (number) - The new position of the item in the list, starting at 1.
##   $total (number) - The total number of items in the list.

moz-box-group-reorder-announcement = Το στοιχείο μετακινήθηκε στη θέση { $position } από { $total }
