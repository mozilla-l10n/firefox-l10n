### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

font-inspector-no-fonts-used = Καμία γραμματοσειρά στο τρέχον στοιχείο.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = Αντιγραφή URL
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Προεπιλογή
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Προσαρμοσμένο

## Labels for the font editor controls

font-inspector-font-size-label = Μέγεθος
font-inspector-font-weight-label = Πάχος
font-inspector-font-italic-label = Πλάγια γραφή

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Εμφάνιση περισσότερων
font-inspector-show-less = Εμφάνιση λιγότερων

##

font-inspector-all-fonts-on-page-header = Όλες οι γραμματοσειρές στη σελίδα
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Γραμματοσειρές σε χρήση
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Κείμενο προεπισκόπησης γραμματοσειράς

