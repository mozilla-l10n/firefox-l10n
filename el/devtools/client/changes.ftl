### These strings are used in the Changes panel, accessible from the Inspector
### sidebar.


## Displayed when no changes have been made yet.


##

changes-copy-all-changes-button = Αντιγραφή όλων των αλλαγών
changes-copy-all-changes-button-title = Αντιγραφή μιας λίστας με όλες τις αλλαγές CSS στο πρόχειρο.
changes-copy-rule-button = Αντιγραφή κανόνα
changes-copy-rule-button-title = Αντιγραφή περιεχομένων του κανόνα CSS στο πρόχειρο.

## Changes panel context menu

changes-context-menu-copy =
    .label = Αντιγραφή
    .accesskey = Α
# Copies the complete contents of the CSS rule.
changes-context-menu-copy-rule =
    .label = Αντιγραφή κανόνα
# Copies the single CSS declaration that was right-clicked.
changes-context-menu-copy-declaration =
    .label = Αντιγραφή δήλωσης
changes-context-menu-select-all =
    .label = Επιλογή όλων
    .accesskey = Ε
