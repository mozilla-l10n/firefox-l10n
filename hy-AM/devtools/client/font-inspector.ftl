### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

# Displayed in place of the font URL when the font is installed locally on the
# system.
font-inspector-system = համակարգ
font-inspector-no-fonts-used = Ընթացիկ բաղադրիչում տառատեսակներ չեն օգտագործվում։
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = Պատճենել URL֊ը
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Հատկանմուշ
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Հարմարեցված

## Labels for the font editor controls

font-inspector-font-size-label = Չափ
font-inspector-font-weight-label = Թավ
font-inspector-font-italic-label = Շեղ
font-inspector-letter-spacing-label = Բացատում
font-inspector-line-height-label = Գծի բարձրություն

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Ցուցադրել ավելին
font-inspector-show-less = Ցուցադրել ավելի քիչ

##

font-inspector-all-fonts-on-page-header = Էջի բոլոր տառատեսակներ
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Օգտագործված տառատեսակներ
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Նախադիտման գրույթի տառատեսակ
