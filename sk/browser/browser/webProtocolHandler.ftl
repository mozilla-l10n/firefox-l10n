protocolhandler-mailto-os-handler-yes-button = Nastaviť ako predvolenú
protocolhandler-mailto-os-handler-no-button = Teraz nie
# Variables:
#  $host (String): The domain of the web application registering as a protocol handler.
#  $protocol (String): The type of protocol (e.g. "web+example").
protocolhandler-add-handler-message = Pridať “{ $host }” ako aplikáciu pre odkazy typu { $protocol }?
protocolhandler-add-handler-button =
    .label = Pridať aplikáciu
    .accesskey = a

## Variables:
##  $url (String): The url of a webmailer, but only its full domain name.

protocolhandler-mailto-handler-set = Používať <strong>{ -brand-short-name(case: "acc") } na otvorenie služby { $url }</strong> zakaždým, keď kliknete na odkaz, ktorý otvorí váš e‑mail?
protocolhandler-mailto-handler-confirm = <strong>{ -brand-short-name } otvorí { $url }</strong> zakaždým, keď kliknete na odkaz, ktorý odosiela e‑mailové správy.
