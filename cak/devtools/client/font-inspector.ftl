### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

# Displayed in place of the font URL when the font is installed locally on the
# system.
font-inspector-system = q'inoj
font-inspector-no-fonts-used = Man xe'okisäx ta taq tz'ib' pa ri ruch'akul wakami.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = Tiwachib'ëx URL
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Tz'eteb'äl
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Ichinan

## Labels for the font editor controls

font-inspector-font-size-label = Nimilem
font-inspector-font-weight-label = Ralal
font-inspector-font-italic-label = Q'e'etz'ib'
font-inspector-letter-spacing-label = Rukojol
font-inspector-line-height-label = Rupalem Juch'

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Kek'ut ch'aqa' chik
font-inspector-show-less = Tik'ut jub'a'

##

font-inspector-all-fonts-on-page-header = Ronojel tz'ib pa ruxaq
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Tz'ib' Okisan
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Nab'ey rutz'etik rutz'ib'anik tz'ib'
