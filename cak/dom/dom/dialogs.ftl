## Unresponsive script dialog

# The & character marks the access key of the checkbox label.
dom-slow-script-dialog-dont-ask-again = &Mani nik'utüx chik pe chwe
dom-slow-script-dialog-stop-button = Tiq'at skript
dom-slow-script-dialog-continue-button = Titikïr chik el
# Variables:
#   $extensionName (String) - Name of the extension running the script.
dom-slow-addon-script-dialog-message =
    Jun rucholajem tz'ib'anïk rik'in ruk'amal “{ $extensionName }” nisamäj pa re ruxaq k'amaya'l re', chuqa' nub'än { -brand-short-name } man nutzolij ta tzij.
    
    Rik'in jub'a' k'o nub'än o kan man xtisamäj ta chik. Yatikïr naq'ät ri rucholajem tz'ib'anïk o tasamajij na richin natz'ët we nitz'aqät.
dom-slow-addon-script-dialog-checkbox = Tatz'eta' chi man tisamäj ri ruk'amal rucholajem tz'ib'anïk pa re ruxaq k'amaya'l re' k'a tisamajin chik na el
