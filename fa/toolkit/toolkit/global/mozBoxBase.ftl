moz-box-link-anchor =
    .title = در زبانهٔ جدید باز می‌شود
moz-box-link-opens-in-new-tab = در زبانهٔ جدید باز می‌شود
moz-box-item-reorder-handle =
    .aria-label = جابه‌جایی مورد با Ctrl+Shift+ArrowUp یا Ctrl+Shift+ArrowDown
# Variables:
#   $item (string) - The label of the moz-box-item being reordered.
moz-box-item-reorder-handle-named =
    .aria-label = جابه‌جایی { $item } با Ctrl+Shift+ArrowUp یا Ctrl+Shift+ArrowDown

## Screen reader announcements made after an item in a reorderable list is moved.
## Variables:
##   $position (number) - The new position of the item in the list, starting at 1.
##   $total (number) - The total number of items in the list.

moz-box-group-reorder-announcement = مورد به جایگاه { $position } از { $total } منتقل شد
