# New Tab Sections with follow and block
experimental-features-newtab-sections-follow-block =
    .label = بخش‌بندی موضوعی و دنبال‌کردن/مسدودسازی برای داستان‌های برگهٔ جدید
experimental-features-newtab-sections-follow-block-description = برای تجربه‌ای ساختاریافته‌تر و مرور آسان‌تر، مقالات صفحهٔ برگهٔ جدید را در بخش‌های موضوعی (ورزش، غذا، سرگرمی و موارد دیگر) دسته‌بندی کنید. با ابزارهای کنترلی جدید «دنبال کردن» و «مسدودسازی»، محتوای نمایشی را مطابق سلیقهٔ خود تنظیم نمایید. <a data-l10n-name="connect">ارسال بازخورد</a>
# Firefox Web Apps
experimental-features-fx-web-apps =
    .label = افزودن وب‌سایت‌ها به نوار وظیفه
# “Add tab to taskbar” is found in the tooltip text of `-taskbar-tab-urlbar-button-open`.
experimental-features-fx-web-apps-description = وب‌سایت‌هایی که مکرراً بازدید می‌کنید را به‌عنوان یک وب‌اپلیکیشن از نوار وظیفه باز کنید. برای اجرای سایت در پنجره‌ای سبک و بهینه با تمامی حفاظت‌های { -brand-product-name }، نماد «افزودن زبانه به نوار وظیفه» را در سمت راست نوار نشانی انتخاب کنید. <a data-l10n-name="connect">ارسال بازخورد</a>

## New Tab Productivity Widgets

# Lists Widget
experimental-features-newtab-widget-lists =
    .label = فهرست‌ها در { -firefox-home-brand-name }
experimental-features-newtab-widget-lists-new =
    .label = فهرست‌ها
experimental-features-newtab-widget-lists-description = هنگام باز کردن یک زبانهٔ جدید، فهرست کارهای مهم خود را همیشه پیش چشم داشته باشید؛ از فهرست وسایل سفر گرفته تا لیست خرید، برنامه‌ریزی‌هایتان را در { -brand-product-name } انجام دهید. <a data-l10n-name="connect">ارسال بازخورد</a>
# Timer Widget
experimental-features-newtab-widget-timer =
    .label = زمان‌سنج در { -firefox-home-brand-name }
experimental-features-newtab-widget-timer-new =
    .label = زمان‌سنج
experimental-features-newtab-widget-timer-description = با تنظیم یک زمان‌سنج، تمرکز خود را حفظ کنید، طبق برنامه پیش بروید یا زمان استراحت را به خود یادآوری نمایید. <a data-l10n-name="connect">ارسال بازخورد</a>
# Lists and Timer Widget (Combined)
experimental-features-newtab-widget-lists-and-timer =
    .label = فهرست‌ها و زمان‌سنج در { -firefox-home-brand-name }
experimental-features-newtab-widget-lists-and-timer-description = با باز کردن زبانهٔ جدید، فهرست کارهای مهم را همواره مقابل دیدگان خود داشته باشید؛ از فهرست وسایل سفر تا لیست خرید، همه را در { -brand-product-name } برنامه‌ریزی کنید. همچنین با تنظیم یک زمان‌سنج، تمرکز خود را حفظ کرده و طبق زمان‌بندی پیش بروید یا استراحت کنید. <a data-l10n-name="connect">ارسال بازخورد</a>
# Weather Widget
experimental-features-newtab-widget-weather =
    .label = پیش‌بینی آب‌وهوا
experimental-features-newtab-widget-weather-description = با پیش‌بینی‌های ساعتی، نمایی دقیق و شفاف از وضعیت آب‌وهوای امروز دریافت کنید. <a data-l10n-name="connect">ارسال بازخورد</a>
# Picture of the Day Widget
experimental-features-newtab-widget-picture-of-the-day =
    .label = تصویر روز
experimental-features-newtab-widget-picture-of-the-day-description = روزمرگی‌تان را با شگفتی همراه کنید؛ هر روز تصویری تازه ببینید، نکته‌ای جذاب یاد بگیرید و در یک چشم برهم زدن پس‌زمینهٔ جدیدی تنظیم کنید. <a data-l10n-name="connect">ارسال بازخورد</a>
# Clocks Widget
experimental-features-newtab-widget-clocks =
    .label = ساعت‌ها
experimental-features-newtab-widget-clocks-description = تا سقف چهار ساعت با نام‌های دلخواه اضافه کنید تا همواره از زمان در مکان‌های مهم زندگی‌تان باخبر باشید. <a data-l10n-name="connect">ارسال بازخورد</a>
# Semantic History Search
experimental-features-semantic-history-search =
    .label = جست‌وجوی معنایی تاریخچه
experimental-features-semantic-history-search-description = بر پایهٔ درک زبان طبیعی در نوار نشانی { -brand-product-name }، از یک مدل محلی یادگیری ماشین برای پیشنهاد صفحات مرتبط از تاریخچهٔ مرور استفاده کنید. <a data-l10n-name="connect">ارسال بازخورد</a>
# Tab Notes
experimental-features-tab-notes =
    .label = یادداشت‌های زبانه
experimental-features-tab-notes-description = یادداشت‌های زبانه قابلیتی آزمایشی است که به شما امکان می‌دهد یادداشت‌های چسبان به زبانه‌های مرورگر خود الصاق کنید. توضیحات، یادآوری‌ها یا مراحل بعدی را یادداشت کنید تا هنگام بازگشت به یاد آورید که چرا آن زبانه را باز کرده بودید. همزمان با توسعه و بهبود این ویژگی، مشتاقانه منتظر دریافت بازخورد شما هستیم. <a data-l10n-name="connect">ارسال بازخورد</a>
# Streamlined Tab Context Menu
experimental-features-tab-context-menu =
    .label = منوی ساده‌شدهٔ زبانه
experimental-features-tab-context-menu-description = با کلیک راست روی یک زبانه، منوی زمینه‌ای ساده‌تری را مشاهده کنید؛ این منو به گونه‌ای طراحی شده که دسترسی به اقدامات متداول را آسان‌تر کند. <a data-l10n-name="connect">ارسال بازخورد</a>
