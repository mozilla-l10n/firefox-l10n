### These strings are used inside the Inspector
### which is available from the Browser Tools sub-menu -> 'Inspect'.

# A title text for the spectrum dragger panel in the color picker tooltip.
colorpicker-tooltip-spectrum-dragger-title = طیف
# A title text for the eyedropper in the color picker tooltip.
colorpicker-tooltip-eyedropper-title = برداشتن رنگ از صفحه
# A title text for the closest color name shown in the color picker tooltip, used together with the actual color.
# Variables:
#   $colorName (String): the color name the current color is closest to.
colorpicker-tooltip-color-name-title = نزدیک‌ترین به: { $colorName }
# A title text for the hue slider in the color picker tooltip.
colorpicker-tooltip-hue-slider-title = فام
# A title text for the alpha slider in the color picker tooltip.
colorpicker-tooltip-alpha-slider-title = تیرگی
# A text for the toggle for the element-specific pseudo-classes panel.
inspector-element-specific-pseudo-classes-heading = شبه‌کلاس‌های ویژهٔ عنصر
# A title text for the button in the Inspector toolbar that opens the menu
# controlling how the Inspector panels are split.
inspector-split-orientation-button-title = چیدمان قاب‌ها
# A label for the split orientation menu item that switches the layout
# automatically based on the panel width.
inspector-split-orientation-auto = خودکار
# A label for the split orientation menu item that locks the panels side by side.
inspector-split-orientation-side-by-side = کنار هم
# A label for the split orientation menu item that locks the panels on top of
# each other.
inspector-split-orientation-stacked = روی هم
# A title text for the light color scheme emulation options
inspector-color-scheme-emulation-light =
    .title = روشن/خاموش کردن شبیه‌سازی طرح رنگ روشن برای صفحه
# A title text for the dark color scheme emulation options
inspector-color-scheme-emulation-dark =
    .title = روشن/خاموش کردن شبیه‌سازی طرح رنگ تیره برای صفحه
# A title text for the emulation panel toggle button in the Rule View toolbar
# that toggles the emulation features panel.
inspector-emulation-panel-toggle =
    .aria-label = روشن/خاموش کردن قابلیت‌های شبیه‌سازی CSS
    .title = روشن/خاموش کردن قابلیت‌های شبیه‌سازی CSS
inspector-emulation-panel-color-scheme = شبیه‌سازی طرح رنگ
# A label text for the print emulation options
inspector-emulation-panel-print = فعال کردن
    .aria-label = فعال کردن شبیه‌سازی رسانهٔ چاپ
# A label text for the light color scheme emulation radio button option.
inspector-emulation-panel-color-scheme-light = روشن
    .aria-label = فعال کردن شبیه‌سازی طرح رنگ روشن
# A label text for the dark color scheme emulation radio button option.
inspector-emulation-panel-color-scheme-dark = تیره
    .aria-label = فعال کردن شبیه‌سازی طرح رنگ تیره
# A label text for the no color scheme emulation radio button option (uses user's preference).
inspector-emulation-panel-color-scheme-none = بدون شبیه‌سازی
    .aria-label = غیرفعال کردن شبیه‌سازی طرح رنگ
# A label text for the reduced motion emulation radio button option.
inspector-emulation-panel-reduced-motion-reduce = کاهش
    .aria-label = فعال کردن شبیه‌سازی حرکت کاهش‌یافته
# A label text for the no preference for reduced motion emulation radio button option.
inspector-emulation-panel-reduced-motion-no-preference = بدون ترجیح
    .aria-label = فعال کردن شبیه‌سازی بدون ترجیح برای حرکت کاهش‌یافته
# A label text for the no reduced motion emulation radio button option (uses user's preference).
inspector-emulation-panel-reduced-motion-none = بدون شبیه‌سازی
    .aria-label = غیرفعال کردن شبیه‌سازی حرکت کاهش‌یافته
