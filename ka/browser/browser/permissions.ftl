perm-persistent-storage-remember = გადაწყვეტილების დამახსოვრება
speech-recognition-model-download-header = გსურთ ხმის ამომცნობის გამართვა?
# $sizeMB (Number) - the model download size in MB.
speech-recognition-model-download-message = { -brand-short-name } იყენებს ხმის ამომცნობს ადგილობრივად, ასე რომ, ხმა არასდროს დატოვებს თქვენს მოწყობილობას. გასამართად, ჩამოიტვირთება ~{ $sizeMB } ᲛᲑ, როცა განაგრძობთ.
speech-recognition-model-download-allow =
    .label = განაგრძეთ
    .accesskey = გ
speech-recognition-model-download-not-now =
    .label = ახლა არა
    .accesskey = ა
speech-recognition-model-download-progress-message = ხმოვანი ამოცნობი მოდელი ჩამოტვირთება
# Accessible name of the progress bar shown while the model downloads. The
# percentage and time remaining are rendered next to it, as text.
speech-recognition-model-download-progressbar =
    .aria-label = ხმის ამომცნობი მოდელის ჩამოტვირთვის მიმდინარეობა
speech-recognition-model-download-cancel =
    .label = გაუქმება
    .accesskey = გ
speech-recognition-model-download-complete-message = ხმის ამომცნობი მოდელი ჩამოიტვირთა.
speech-recognition-model-download-failed-message = ხმის ამომცნობი მოდელის ჩამოტვირთვა ვერ მოხერხდა.
speech-recognition-model-download-ok =
    .label = კარგი
    .accesskey = კ
