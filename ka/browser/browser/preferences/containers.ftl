containers-icon-label2 =
    .label = ხატულა
containers-color-label2 =
    .label = ფერი
containers-dialog2 =
    .buttonlabelaccept = შენახვა
    .buttonaccesskeyaccept = ხ
containers-dialog =
    .buttonlabelaccept = მზადაა
