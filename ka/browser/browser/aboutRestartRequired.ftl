restart-required-title = საჭიროებს ხელახლა გაშვებას
restart-required-heading2 = ვწუხვართ, { -brand-short-name } საჭიროებს სწრაფ გადატვირთვას
restart-required-intro2 = { -brand-short-name } საჭიროებს განახლებას. ახლიდან გაუშვით უსაფრთხოებისა და შეუფერხებლად მუშაობისთვის.
window-restoration-info2 = ხელახლა გაიხსნება ყველა ფანჯარა და ჩანართი პირადის გარდა.
restart-required-why-now-question = რატომ ახლა?
restart-required-why-now-answer = ეს მაშინ ხდება, როცა ცალკე გაშვებული სხვა { -brand-short-name } აახლებს პროფილს ან, როცა განახლება ვერ უცდის მომდევნო გადატვირთვას.
restart-required-more-details-heading = უფრო ვრცლად
restart-required-multiple-instances-question = რატომ შეიძლება ამის მიზეზი იყოს რამდენიმე პროფილი ან ცალკე გაშვებული სხვა { -brand-short-name }?
restart-required-multiple-instances-answer = თუ ერთი-ერთი პროფილი ან ცალკე ახალი გაშვებული განახლდება, როცა წინა ჯერ არ დახურულა, წინა გახსნილი რჩება ხოლმე ძველ ვერსიაზე. ხელახლა გაშვებისას კი ყველაფერი ერთ ვერსიაზე დგება.
restart-required-single-instance-question = არ ვიყენებ რამდენიმე პროფილს და არც ცალკე ახალი არ გამიშვია. მაინც რატომ ხდება?
restart-required-single-instance-answer = { -brand-short-name } შესაძლოა ახლიდან გაშვებას მაშინაც საჭიროებდეს, თუ გახსნისას ფონურად განახლდა.
restart-required-single-instance-answer-2 = ეს შეიძლება მოხდეს გვერდების გრძელვადიანი თვალიერებისას ან, როცა თქვენი საოპერაციო სისტემა თავად ცდილობს განაახლოს { -brand-short-name }. ხელახლა გაშვებით { -brand-short-name } შეძლებს იმუშაოს უსაფრთხოდ და შეუფერხებლად.
restart-required-unsaved-work-question = შეიძლება დავკარგო შეუნახავი სამუშაო?
restart-required-unsaved-work-answer = შესაძლოა, და კარგად გვესმის, რამხელა იმედგაცრუება შეიძლება იყოს. { -brand-short-name } ხელახლა გახსნის თქვენს ჩანართებს, მაგრამ უშუალოდ საიტზე შეუნახავი სამუშაო, მათ შორის ველებში შეყვანილი ტექსტი, შეიძლება ვეღარ აღდგეს. პირადი ფანჯრები ასევე აღარ გაიხსნება თქვენი პირადი მონაცემების უსაფრთხოებისთვის.
restart-required-fix-question = ეს ნამდვილად გამაღიზიანებელია! { -brand-short-name } მუშაობს ამის გამოსასწორებლად?
# Note: normally we would link to the bug here, but if the user sees this message,
# then they cannot visit a link without a restart.
restart-required-fix-answer = დიახ. კარგად გვესმის, რომ მეტად დამაზარალებელია და ვმუშაობთ მის აღსაკვეთად. თვალი რომ ადევნოთ ჩვენს წინსვლას, მოინახულეთ Bugzilla და იპოვეთ ხარვეზი 2072739.
restart-button-label2 = კვლავ გაშვება
# Expands the "More details" section below the buttons.
restart-required-see-more-button = ვრცლად
# Collapses the "More details" section below the buttons.
restart-required-see-less-button = შემოკლებულად
restart-required-heading = ხელახლა გაუშვით { -brand-short-name }, რომ განაგრძოთ
restart-required-intro = { -brand-short-name } ახლდება ფონურად. დასასრულებლად საჭიროებს გადატვირთვას.
window-restoration-info = სწრაფადვე აღდგება ყველა ფანჯარა და ჩანართი, გარდა პირადისა
restart-button-label = ხელახლა გაეშვას { -brand-short-name }
