moz-box-link-anchor =
    .title = გახსნის ახალ ჩანართში
moz-box-link-opens-in-new-tab = გახსნის ახალ ჩანართში
moz-box-item-reorder-handle =
    .aria-label = რომ გადაალაგოთ, გამოიყენეთ Ctrl+Shift+ზემოთ ან Ctrl+Shift+ქვემოთ
# Variables:
#   $item (string) - The label of the moz-box-item being reordered.
moz-box-item-reorder-handle-named =
    .aria-label = რომ გადაალაგოთ { $item }, გამოიყენეთ Ctrl+Shift+ზემოთ ან Ctrl+Shift+ქვემოთ

## Screen reader announcements made after an item in a reorderable list is moved.
## Variables:
##   $position (number) - The new position of the item in the list, starting at 1.
##   $total (number) - The total number of items in the list.

moz-box-group-reorder-announcement = გადაადგილდა და მისი ადგილია { $position }, სულ { $total }
