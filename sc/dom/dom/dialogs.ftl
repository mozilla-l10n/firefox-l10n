## Unresponsive script dialog

dom-slow-script-dialog-title = Atentzione: su script non rispondet
# Variables:
#   $location (String) - URL of the script, followed by a colon and the line number (e.g. “https://example.com/script.js:42”). Long URLs are shortened with an ellipsis in the middle.
dom-slow-script-dialog-location = Script: { $location }
# The & character marks the access key of the checkbox label.
dom-slow-script-dialog-dont-ask-again = &Non mi preguntes torra
dom-slow-script-dialog-stop-button = Firma su script
dom-slow-script-dialog-continue-button = Sighi
dom-slow-addon-script-dialog-title = Atentzione: su script de cumplementu non rispondet
dom-slow-addon-script-dialog-checkbox = Èvita chi su script de s’estensione siat esecutadu in custa pàgina fintzas a cando non bèngiat torrada a carrigare
