### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

# Displayed in place of the font URL when the font is installed locally on the
# system.
font-inspector-system = sistema
font-inspector-no-fonts-used = Nissuna tipografia impreada in s'elementu atuale.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = Còpia s'URL
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Istàntzia
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Personalizada

## Labels for the font editor controls

font-inspector-font-size-label = Mannària
font-inspector-font-italic-label = Cursivu

## Labels for font metadata, displayed in the "All Fonts on Page" section.

font-inspector-font-version = Versione:
font-inspector-font-designer = Disinnu:
font-inspector-font-manufacturer = Produtzione:
font-inspector-font-vendor = Frunidore:
font-inspector-font-description = Descritzione:
font-inspector-font-license = Lissèntzia:
font-inspector-font-license-info-url = URL de is informatziones de sa lissèntzia:

##

# Button displayed to expand a truncated value (e.g. Description or License).
font-inspector-show-full-text = Ismànnia
