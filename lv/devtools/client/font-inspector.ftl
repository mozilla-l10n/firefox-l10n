### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

# Displayed in place of the font URL when the font is installed locally on the
# system.
font-inspector-system = sistēmas
font-inspector-no-fonts-used = Šim elementam netika atrasts neviens fonts.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = Kopēt adresi
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Instance
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Pielāgots

## Labels for the font editor controls

font-inspector-font-size-label = Izmērs
font-inspector-font-weight-label = Svars
font-inspector-font-italic-label = Slīpraksts
font-inspector-letter-spacing-label = Atstatums
font-inspector-line-height-label = Līnijas augstums

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Rādīt vairāk
font-inspector-show-less = Rādīt mazāk

##

font-inspector-all-fonts-on-page-header = Visi fonti lapā
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Lietotie fonti
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Fonta priekšskatījuma teksts

## Labels for font metadata, displayed in the "All Fonts on Page" section.

font-inspector-font-version = Versija:
font-inspector-font-designer = Dizainers:
font-inspector-font-manufacturer = Ražotājs:
font-inspector-font-vendor = Ražotājs:
font-inspector-font-description = Apraksts:
font-inspector-font-license = Licence:
font-inspector-font-license-info-url = Licences informācijas URL:

##

# Button displayed to expand a truncated value (e.g. Description or License).
font-inspector-show-full-text = Izvērst
