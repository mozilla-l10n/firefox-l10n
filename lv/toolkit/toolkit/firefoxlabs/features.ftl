# The title of the experiment should be kept in English as it may be referenced
# by various online articles and is technical in nature.
experimental-features-media-jxl =
    .label = Multivide: JPEG XL
experimental-features-media-jxl-description = Ja šī funkcija ir iespējota, { -brand-short-name } atbalsta JPEG XL (JXL) formātu. Tas ir uzlabots attēlu failu formāts, kas atbalsta bezzudumu pāreju no tradicionālajiem JPEG failiem. Plašāku informāciju skatiet <a data-l10n-name="bugzilla">bug 1539075</a>.
# JS JIT Warp project
experimental-features-js-warp =
    .label = JavaScript JIT: Warp
experimental-features-js-warp-description = Iespējojiet Warp — projektu, lai uzlabotu JavaScript veiktspēju un atmiņas izmantošanu.
# Search during IME
experimental-features-ime-search =
    .label = Adrešu josla: rādīt rezultātus IME veidošanas laikā
experimental-features-ime-search-description = IME (ievades veida labotājs) ir rīks, kas ļauj ievadīt sarežģītas rakstzīmes, piemēram, Austrumāzijas vai indiešu rakstības valodās izmantotās ar parasto tastatūru. Šī izmēģinājuma iespējošana turēs adreses joslu atvērtu, rādot meklēšanas iznākumu un ieteikumus, kamēr IME tiks izmantots teksta ievadīšanai. Jāņem vērā, ka IME var parādīt paneli, kas aizsedz adreses joslas iznākumu, tāpēc šī izvēle ir ieteicama tikai IME, kas neizmanto šāda veida paneli.
experimental-features-group-developer-tools =
    .label = Izstrādātāju rīki
experimental-features-group-webpage-display =
    .label = Tīmekļa lapas attēlošana
experimental-features-group-customize-browsing =
    .label = Pielāgojiet savu pārlūkošanu
experimental-features-group-productivity =
    .label = Produktivitāte
experimental-features-group-newtab-widgets =
    .label = Logrīki vietnē { -firefox-home-brand-name }
# New Tab Custom Wallpapers
experimental-features-custom-wallpaper =
    .label = Izvēlieties pielāgotu fona attēlu vai krāsu jaunai cilnei
experimental-features-custom-wallpaper-description = Augšupielādējiet savu fonu vai izvēlieties pielāgotu krāsu savas jaunās cilnes fonam.
# Link Previews with AI
experimental-features-link-previews =
    .label = Saites priekšskatījumi
experimental-features-link-previews-description =
    { PLATFORM() ->
        [macos] Lai pirms noklikšķināšanas uz tīmekļa lapas uzzinātu vairāk, novietojiet kursoru virs tās un nospiediet taustiņu kombināciju Shift (⇧) un Option (⌥) vai Alt. Priekšskatījumos var būt iekļauta informācija, piemēram, nosaukums un lasīšanas laiks. Dažām tīmekļa lapām mākslīgais intelekts var arī nolasīt lapas tekstu un ģenerēt galvenos punktus. Mākslīgais intelekts ir optimizēts angļu valodas teksta lasīšanai un ģenerēšanai. Lai nodrošinātu jūsu privātuma prioritāti, mākslīgais intelekts darbojas lokāli jūsu datorā. <a data-l10n-name="connect">Kopīgot atsauksmes</a>
       *[other] Lai pirms noklikšķināšanas uz tīmekļa lapas uzzinātu vairāk, novietojiet kursoru virs saites un nospiediet taustiņu kombināciju Shift+Alt. Priekšskatījumos var būt iekļauta informācija, piemēram, nosaukums un lasīšanas laiks. Dažām tīmekļa lapām mākslīgais intelekts var arī nolasīt lapas tekstu un ģenerēt galvenos punktus. Mākslīgais intelekts ir optimizēts angļu valodas teksta lasīšanai un ģenerēšanai. Lai nodrošinātu jūsu privātuma prioritāti, mākslīgais intelekts darbojas lokāli jūsu datorā. <a data-l10n-name="connect">Kopīgot atsauksmes</a>
    }
# This version of the link previews description does not mention AI.
experimental-features-link-previews-description-no-ai =
    { PLATFORM() ->
        [macos] Lai pirms noklikšķināšanas uz tīmekļa lapas uzzinātu vairāk, novietojiet kursoru virs saites un nospiediet taustiņu kombināciju Shift (⇧) un Option (⌥) vai Alt. Priekšskatījumos var būt iekļauta informācija, piemēram, nosaukums un lasīšanas laiks. <a data-l10n-name="connect">Kopīgot atsauksmes</a>
       *[other] Lai uzzinātu vairāk par tīmekļa lapu pirms noklikšķināšanas, novietojiet kursoru virs saites un nospiediet taustiņu kombināciju Shift+Alt. Priekšskatījumos var būt iekļauta informācija, piemēram, nosaukums un lasīšanas laiks. <a data-l10n-name="connect">Kopīgot atsauksmes</a>
    }
# New Tab Sections with follow and block
experimental-features-newtab-sections-follow-block =
    .label = Tēmu sadaļas un sekošana/bloķēšana jaunu cilņu stāstiem
experimental-features-newtab-sections-follow-block-description = Organizējiet stāstus savā Jaunas cilnes lapā tēmu sadaļās (sports, ēdiens, izklaide un citi), lai nodrošinātu strukturētāku un vieglāk pārskatāmu pieredzi. Izmantojiet mūsu jaunās sekošanas un bloķēšanas vadīklas, lai pielāgotu redzamo saturu. <a data-l10n-name="connect">Kopīgojiet atsauksmes</a>
# Firefox Web Apps
experimental-features-fx-web-apps =
    .label = Pievienot vietnes uzdevumjoslai
# “Add tab to taskbar” is found in the tooltip text of `-taskbar-tab-urlbar-button-open`.
experimental-features-fx-web-apps-description = Atveriet bieži apmeklētās vietnes kā tīmekļa lietotni no uzdevumjoslas. Meklējiet ikonu “Pievienot cilni uzdevumjoslai” adreses joslas labajā pusē, lai palaistu šo vietni vienkāršotā logā ar visām { -brand-product-name } aizsardzības funkcijām. <a data-l10n-name="connect">Kopīgot atsauksmes</a>

## New Tab Productivity Widgets

# Lists Widget
experimental-features-newtab-widget-lists =
    .label = Logrīks Saraksti iespējots { -firefox-home-brand-name }
experimental-features-newtab-widget-lists-new =
    .label = Logrīks Saraksti
experimental-features-newtab-widget-lists-description = Atverot jaunu cilni, paturiet prātā savu darāmo lietu sarakstu. Sākot ar mantu iesaiņošanas sarakstiem un beidzot ar iepirkumu sarakstiem, izveidojiet savus plānus lietotnē { -brand-product-name }. <a data-l10n-name="connect">Kopīgojiet atsauksmes</a>.
# Timer Widget
experimental-features-newtab-widget-timer =
    .label = Logrīks Taimeris iespējots { -firefox-home-brand-name }
experimental-features-newtab-widget-timer-new =
    .label = Logrīks Taimeris
experimental-features-newtab-widget-timer-description = Iestatiet taimeri, lai saglabātu koncentrēšanos, mudinātu jūs palikt uz pareizā ceļa vai atgādinātu jums uzlādēties. <a data-l10n-name="connect">Dalieties ar atsauksmēm</a>
# Lists and Timer Widget (Combined)
experimental-features-newtab-widget-lists-and-timer =
    .label = Logrīki Saraksti un Taimeris vietnē iespējoti { -firefox-home-brand-name }
experimental-features-newtab-widget-lists-and-timer-description = Atverot jaunu cilni, paturiet prātā savu darāmo lietu sarakstu. Sākot ar mantu sarakstiem un beidzot ar iepirkumu sarakstiem, izveidojiet savus plānus lietotnē { -brand-product-name }. Iestatiet taimeri, lai saglabātu koncentrēšanos, mudinātu jūs palikt uz pareizā ceļa vai atgādinātu jums uzlādēties. <a data-l10n-name="connect">Kopīgojiet atsauksmes</a>
# Weather Widget
experimental-features-newtab-widget-weather =
    .label = Laika prognozes
experimental-features-newtab-widget-weather-description = Iegūstiet skaidru priekšstatu par šodienas laikapstākļiem, izmantojot stundas prognozes. <a data-l10n-name="connect">Kopīgojiet atsauksmes</a>
# Picture of the Day Widget
experimental-features-newtab-widget-picture-of-the-day =
    .label = Dienas bilde
experimental-features-newtab-widget-picture-of-the-day-description = Piešķiriet savai dienai nedaudz brīnuma. Uzņemiet jaunu attēlu, uzziniet kaut ko interesantu un acumirklī iestatiet jaunu fona attēlu. <a data-l10n-name="connect">Dalieties ar atsauksmēm</a>
# Clocks Widget
experimental-features-newtab-widget-clocks =
    .label = Pulksteņi
experimental-features-newtab-widget-clocks-description = Pievienojiet līdz pat četriem pulksteņiem ar pielāgotiem segvārdiem, lai sekotu līdzi laikam jums svarīgās vietās. <a data-l10n-name="connect">Kopīgojiet atsauksmes</a>
# Semantic History Search
experimental-features-semantic-history-search =
    .label = Semantiskās vēstures meklēšana
experimental-features-semantic-history-search-description = Izmantojiet lokālu mašīnmācīšanās modeli, lai ieteiktu ierakstus no vēstures, kas saistīti ar jūsu meklējumiem, pamatojoties uz dabiskās valodas izpratni { -brand-product-name } adreses joslā. <a data-l10n-name="connect">Kopīgot atsauksmes</a>
# Tab Notes
experimental-features-tab-notes =
    .label = Cilnes piezīmes
experimental-features-tab-notes-description = Cilņu piezīmes ir eksperimentāla funkcija, kas ļauj pievienot piezīmju lapiņas pārlūkprogrammas cilnēm. Pierakstiet kontekstu, atgādinājumus vai nākamās darbības, lai varētu atgriezties un atcerēties, kāpēc to atvērāt. Mēs labprāt uzklausītu jūsu atsauksmes, jo mēs turpinām uzlabot šo funkciju. <a data-l10n-name="connect">Kopīgot atsauksmes</a>
# Streamlined Tab Context Menu
experimental-features-tab-context-menu =
    .label = Optimizēta cilņu izvēlne
experimental-features-tab-context-menu-description = Ar peles labo pogu noklikšķinot uz cilnes, skatiet vienkāršāku konteksta izvēlni. Tā ir izstrādāta, lai atvieglotu bieži veicamo darbību atrašanu. <a data-l10n-name="connect">Kopīgot atsauksmes</a>
