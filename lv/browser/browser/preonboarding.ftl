## Preonboarding modal screen strings

preonboarding-title = Laipni lūdzam { -brand-product-name }
preonboarding-subtitle = Turpinot, jūs piekrītat { -brand-product-name } lietošanas noteikumiem un mūsu paziņojumam par konfidencialitāti. Lai uzlabotu pārlūku, { -brand-product-name } nosūta diagnostikas un mijiedarbības datus uz { -vendor-short-name }.
preonboarding-primary-cta = Apstiprināt un turpināt
preonboarding-primary-cta-v2 = Turpināt
# Labels for header style button that toggles showing the terms of use, privacy notice, and data preferences checklist
preonboarding-manage-and-read-header = Pārvaldīt datu vākšanas iestatījumus lasīt mūsu izmantošanas noteikumus un privātuma paziņojumu
preonboarding-manage-and-read-header-v2 = Lasīt izmantošanas noteikumus un privātuma paziņojumu. Pārvaldīt papildu iestatījumus.
# Label for header style button that toggles showing the Terms of Use
preonboarding-terms-of-use-header-button-title = Izlasiet mūsu lietošanas noteikumus
# Label for header style button that toggles showing the Privacy Notice
preonboarding-privacy-notice-header-button-title = Lasīt mūsu privātuma paziņojumu
# Label for header style button that toggles showing the data preference checklist
preonboarding-manage-data-header-button-title = Pārvaldīt diagnostikas un mijiedarbības datus
# Labels for header style button that toggles showing the Terms of Use (Variant B)
preonboarding-terms-of-use-header-button-title-b = { -brand-product-name } Lietošanas noteikumi
preonboarding-terms-of-use-header-button-title-b-v2 = Lietošanas noteikumi
# Labels for header style button that toggles showing the Privacy Notice (Variant B)
preonboarding-privacy-notice-header-button-title-b = { -brand-product-name } Privātuma paziņojums
preonboarding-privacy-notice-header-button-title-b-v2 = Privātuma paziņojums
# Description under label for header style buttons
preonboarding-header-button-description = Lasīt vairāk
# New user onboarding checklist
preonboarding-checklist-interaction-data-label = Sūtīt tehniskos un mijiedarbības datus uz { -vendor-short-name }
preonboarding-checklist-interaction-data-description = Dati par jūsu ierīci, aparatūras konfigurāciju un to, kā jūs izmantojat { -brand-product-name }, palīdz uzlabot funkcijas, veiktspēju un stabilitāti lietotājiem visā pasaulē.
preonboarding-checklist-crash-reports-label = Automātiski sūtīt avāriju pārskatus
preonboarding-checklist-crash-reports-description = Avāriju pārskati ļauj mums diagnosticēt un novērst problēmas ar pārlūku. Pārskatos var būt iekļauti personas vai sensitīvi dati.
