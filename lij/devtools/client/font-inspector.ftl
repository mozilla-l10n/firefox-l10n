### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

font-inspector-no-fonts-used = Nisciun caratere deuviou pe l'elemento corente.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = Còpia URL
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Istansa
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Personalizzou

## Labels for the font editor controls

font-inspector-font-size-label = Dimenscion
font-inspector-font-weight-label = Peizo
font-inspector-font-italic-label = Corsivo
font-inspector-line-height-label = Altessa linia

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Fanni vedde de ciù
font-inspector-show-less = Fanni vedde de meno

##

font-inspector-all-fonts-on-page-header = Tutti i carateri da pagina
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Carateri adeuviæ
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Anteprimma do caratere do testo

