## Unresponsive script dialog

dom-slow-script-dialog-title = Yuamo: script ónoñede
dom-slow-script-dialog-message = Bíe Script ñete rabeniko, já fáɨrioñede. Bírui ó moziredɨo, úñoakadɨio fúi moziri.
# Variables:
#   $location (String) - URL of the script, followed by a colon and the line number (e.g. “https://example.com/script.js:42”). Long URLs are shortened with an ellipsis in the middle.
dom-slow-script-dialog-location = Script: { $location }
# The & character marks the access key of the checkbox label.
dom-slow-script-dialog-dont-ask-again = &Jɨkánoñeno ábɨdo
dom-slow-script-dialog-stop-button = Mozide Script
dom-slow-script-dialog-continue-button = Ɨfori
