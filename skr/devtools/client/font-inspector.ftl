### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

# Displayed in place of the font URL when the font is installed locally on the
# system.
font-inspector-system = سسٹم
font-inspector-no-fonts-used = موجودہ عنصر تے کوئی فونٹ استعمال نئیں کیتا ڳیا۔
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = URL نقل کرو
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = مثال
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = مخصوص

## Labels for the font editor controls

font-inspector-font-size-label = سائز
font-inspector-font-weight-label = وزن
font-inspector-font-italic-label = اٹالک
font-inspector-letter-spacing-label = وقفہ کاری
font-inspector-line-height-label = سطر دی اوچائی

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = ودھیک ݙکھاؤ
font-inspector-show-less = گھٹ ݙکھاؤ

##

font-inspector-all-fonts-on-page-header = ورقے تے تمام فونٹس
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = استعمال تھئے فونٹس
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = فونٹ دا پیش نظارہ متن

## Labels for font metadata, displayed in the "All Fonts on Page" section.

font-inspector-font-version = ورژن:
font-inspector-font-designer = ڈیزائنر:
font-inspector-font-manufacturer = مینوفیکچرر:
font-inspector-font-vendor = وینڈر:
font-inspector-font-description = تفصیل:
font-inspector-font-license = لائسنس:
font-inspector-font-license-info-url = لائسنس دی معلومات دا یو آر ایل:

##

# Button displayed to expand a truncated value (e.g. Description or License).
font-inspector-show-full-text = کھنڈاؤ
