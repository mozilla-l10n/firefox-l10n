### These strings are used inside the Inspector
### which is available from the Browser Tools sub-menu -> 'Inspect'.

# A title text for the spectrum dragger panel in the color picker tooltip.
colorpicker-tooltip-spectrum-dragger-title = سپیکٹرم
# A title text for the eyedropper in the color picker tooltip.
colorpicker-tooltip-eyedropper-title = ورقے تے رنگ چݨو
# A title text for the closest color name shown in the color picker tooltip, used together with the actual color.
# Variables:
#   $colorName (String): the color name the current color is closest to.
colorpicker-tooltip-color-name-title = قریب ترین: { $colorName }
# A title text for the hue slider in the color picker tooltip.
colorpicker-tooltip-hue-slider-title = رنگت
# A title text for the alpha slider in the color picker tooltip.
colorpicker-tooltip-alpha-slider-title = دھندلاپن
# A text for the toggle for the element-specific pseudo-classes panel.
inspector-element-specific-pseudo-classes-heading = عنصر-مخصوص چھدم-طبقے
# A title text for the button in the Inspector toolbar that opens the menu
# controlling how the Inspector panels are split.
inspector-split-orientation-button-title = پینل دی ترتیب
# A label for the split orientation menu item that switches the layout
# automatically based on the panel width.
inspector-split-orientation-auto = آٹو
# A label for the split orientation menu item that locks the panels side by side.
inspector-split-orientation-side-by-side = نال نال
# A label for the split orientation menu item that locks the panels on top of
# each other.
inspector-split-orientation-stacked = سٹیک
# A title text for the light color scheme emulation options
inspector-color-scheme-emulation-light =
    .title = ورقہ کیتے لائٹ کلر سکیم سمولیشن ٹوگل کرو۔
# A title text for the dark color scheme emulation options
inspector-color-scheme-emulation-dark =
    .title = ورقہ کیتے ڳھاٹا رنگ سکیم سمولیشن ٹوگل کرو۔
# A title text for the emulation panel toggle button in the Rule View toolbar
# that toggles the emulation features panel.
inspector-emulation-panel-toggle =
    .aria-label = CSS ایمولیشن فیچرز ٹوگل کرو
    .title = CSS ایمولیشن فیچرز ٹوگل کرو
