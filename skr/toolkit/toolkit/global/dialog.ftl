## Default button labels for <dialog> elements

dialog-button-accept =
    .label = ٹھیک ہے
dialog-button-cancel =
    .label = منسوخ
dialog-button-disclosure =
    .label = ودھیک معلومات
    .accesskey = I

## Predefined button labels for dialogs created with nsIPrompt.confirmEx()

dialog-button-yes =
    .label = ہا
    .accesskey = Y
dialog-button-no =
    .label = تے کائناں
    .accesskey = N
dialog-button-save =
    .label = تے ہتھیکڑا کرو
    .accesskey = S
dialog-button-dont-save =
    .label = تے ہتھیکڑا نہ کرو
    .accesskey = n
dialog-button-revert =
    .label = تے  پُٹھا کرو
    .accesskey = R
