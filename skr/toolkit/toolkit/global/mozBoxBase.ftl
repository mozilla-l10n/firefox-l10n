moz-box-link-anchor =
    .title = نویں ٹیب اچ کھلدے
moz-box-link-opens-in-new-tab = نویں ٹیب وچ کھلدا ہے
moz-box-item-reorder-handle =
    .aria-label = Ctrl+Shift+ArrowUp یا Ctrl+Shift+ArrowDown ورت کے آئٹم کوں دوبارہ ترتیب ݙیو
# Variables:
#   $item (string) - The label of the moz-box-item being reordered.
