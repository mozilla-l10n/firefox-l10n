# New Tab Sections with follow and block
experimental-features-newtab-sections-follow-block =
    .label = نواں ٹیب سٹوریاں کیتے ٹوپک سیکشنز تے فالو/بلاک
experimental-features-newtab-sections-follow-block-description = اپݨے نواں ٹیب صفحے دیاں سٹوریاں کوں موضوع سیکشنز (کھیل، خوراک، تفریح تے ٻیاں) وچ ترتیب ݙیو تے منظم تے آسان پڑھݨ والا تجربہ حاصل کرو۔ تہاݙی پسند دا مواد وکھاوݨ کیتے ساݙے نویں فالو تے بلاک کنٹرولز ورتو۔ <a data-l10n-name="connect">رائے ݙیو</a>
# Firefox Web Apps
experimental-features-fx-web-apps =
    .label = اپݨی ٹاسک بار تے سائٹاں شامل کرو
# “Add tab to taskbar” is found in the tooltip text of `-taskbar-tab-urlbar-button-open`.
experimental-features-fx-web-apps-description = تساں جیڑھیاں سائٹاں اکثر ویکھدے ہو انہاں کوں اپݨی ٹاسک بار توں ویب ایپ وانگوں کھولو۔ اوں سائٹ کوں { -brand-product-name } دے سارے تحفظات نال ہک سادہ ونڈو وچ چلاوݨ کیتے ایڈریس بار دے کھبے پاسے “Add tab to taskbar” آئیکن لبھو۔ <a data-l10n-name="connect">رائے ݙیو</a>

