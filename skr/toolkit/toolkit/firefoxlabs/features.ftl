# Link Previews with AI
experimental-features-link-previews =
    .label = لنک پریویوز
experimental-features-link-previews-description =
    { PLATFORM() ->
        [macos] کسی ویب پیج بارے کلک کرݨ توں پہلے ٻیاں معلومات کیتے، لنک تے ہوور کرو تے Shift (⇧) نال Option (⌥) یا Alt دباؤ۔ پریویوز وچ عنوان تے پڑھݨ دا وقت جہیاں تفصیلاں شامل ہو سکدیاں ہن۔ کجھ ویب پیجاں کیتے، اے آئی صفحے دا متن وی پڑھ سکدی ہے تے اہم نکات تیار کر سکدی ہے۔ اے آئی انگریزی متن پڑھݨ تے تیار کرݨ کیتے بہتر بݨایا ڳیا ہے۔ تہاݙی رازداری کوں پہلے رکھݨ کیتے، اے آئی تہاݙے کمپیوٹر تے مقامی طور تے چلدا ہے۔ <a data-l10n-name="connect">رائے ݙیو</a>
       *[other] کسی ویب پیج بارے کلک کرݨ توں پہلے ٻیاں معلومات کیتے، لنک تے ہوور کرو تے Shift + Alt دباؤ۔ پریویوز وچ عنوان تے پڑھݨ دا وقت جہیاں تفصیلاں شامل ہو سکدیاں ہن۔ کجھ ویب پیجاں کیتے، اے آئی صفحے دا متن وی پڑھ سکدی ہے تے اہم نکات تیار کر سکدی ہے۔ اے آئی انگریزی متن پڑھݨ تے تیار کرݨ کیتے بہتر بݨایا ڳیا ہے۔ تہاݙی رازداری کوں پہلے رکھݨ کیتے، اے آئی تہاݙے کمپیوٹر تے مقامی طور تے چلدا ہے۔ <a data-l10n-name="connect">رائے ݙیو</a>
    }
