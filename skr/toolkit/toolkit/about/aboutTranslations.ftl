# The title of the about:translations page.
about-translations-title = { -brand-short-name } ترجمے
# The brief description of the Translations functionality on the page.
about-translations-description = فوری ترجمے جیہڑے تہاݙی پرائیویسی دا احترام کریندن۔
about-translations-learn-more-link = ٻیا سِکھو
# An info message displayed if the device's hardware is not compatible with the Translations feature requirements.
about-translations-unsupported-info-message-2 =
    .heading = ایہ ڈیوائس تے ترجمہ دستیاب نئیں۔
    .message = ٻئی ڈیوائس استعمال کرݨ دی کوشش کرو۔
# An info message displayed when translations are disabled and locked by enterprise policy.
about-translations-policy-disabled-info-message =
    .heading = ترجمے تہاݙی تنظیم کیتے دستیاب نئیں۔
    .message = ایہ تہاݙے ایڈمنسٹریٹر دی طرفوں مقرر پالیسی ہے۔
# An info message displayed when translations are disabled but can still be unblocked.
about-translations-feature-blocked-info-message =
    .heading = متن دا ترجمہ کرݨ کیتے ایہ خصوصیت ان بلاک کرو۔
    .message = لڳدا ہے تساں اے آئی کنٹرولز کوں ایہ خصوصیت بلاک کرݨ کیتے اپڈیٹ کیتا ہے۔ اینکوں استعمال کرݨ کیتے کݙاہیں وی ان بلاک کرو۔
about-translations-feature-blocked-unblock-button = انبلاک کرو
# An error message displayed when the language list fails to load.
about-translations-language-load-error-message-2 =
    .heading = زباناں لوڈ کائنی کر سڳا
    .message = آپݨے انٹرنیٹ کنکشن دی پڑتال کرو تے ولدا کوشش کرو۔
about-translations-language-load-error-button = ولدا کوشش کرو
# An error message displayed when a translation request fails.
about-translations-translation-error-heading = ترجمہ کرݨ وچ ہِک مسئلہ تھیا۔
about-translations-translation-error-subtext = سوہݨا ولدا کوشش کرو۔
about-translations-translation-error-button = ولدا کوشش کرو
# An informational message displayed when the detected language is not supported.
# Variables:
#   $language (String) - The display name of the detected language.
about-translations-detected-language-unsupported-heading-2 = افسوس، اساں { $language } کوں سہارا نسے ݙیندے۔
about-translations-detected-language-unsupported-heading-unknown-2 = افسوس، اساں اڄݨ ایں زبان کوں سہارا نسے ݙیندے۔
about-translations-detected-language-unsupported-subtext = سوہݨا ٻئی زبان چُݨو۔
# Placeholder text shown in the source-language text area when the user has not typed any text.
about-translations-input-placeholder =
    .placeholder = ترجمہ کرݨ کیتے متن شامل کرو
# Text displayed on the source-language selector when no explicit option is selected
# and no language has been identified from the content of the source-language text area.
about-translations-detect-default-label =
    .label = زبان پتہ لاؤ
# Text displayed on the source-language selector when no explicit option is selected
# and a valid language has been identified from the content of the source-language text area.
# Variables:
#   $language (string) - The localized display name of the detected language
about-translations-detect-language-label =
    .label = { $language } (پتہ لایا ڳئی)
# Placeholder text shown in the target-language output area when no translation has occurred.
about-translations-output-placeholder =
    .placeholder = ترجمہ
# Button label for copying the translated output to the clipboard.
about-translations-copy-button-default =
    .label = نقل کرو
    .title = ترجمہ نقل کرو
# Button label shown after the translated output has been copied to the clipboard.
about-translations-copy-button-copied =
    .label = کاپی تھئی ڳیا
    .title = ترجمہ نقل کرو
# Text displayed on target-language selector when no language option is selected.
about-translations-select-label =
    .label = زبان چُݨو
# A message displayed in the target-language output area while waiting for the translation to complete.
about-translations-translating-message = ترجمہ کریندا پئے۔۔۔
# The title attribute for the swap languages button, which swaps the selected
# source and target languages, reversing the direction of translation.
about-translations-swap-languages =
    .title = زباناں بدلاؤ
# The title attribute for the button that clears the source text area.
about-translations-clear-button =
    .title = ذرائع متن صاف کرو
