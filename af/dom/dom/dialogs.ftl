## Unresponsive script dialog

dom-slow-script-dialog-title = Let wel: Reageertrae skrip
dom-slow-script-dialog-message = 'n Skrip op hierdie bladsy is dalk besig, of dit het opgehou loop. U kan die skrip nou stop, of u kan voortgaan om te kyk of die skrip sal klaar maak.
# Variables:
#   $location (String) - URL of the script, followed by a colon and the line number (e.g. “https://example.com/script.js:42”). Long URLs are shortened with an ellipsis in the middle.
dom-slow-script-dialog-location = Skrip: { $location }
# The & character marks the access key of the checkbox label.
dom-slow-script-dialog-dont-ask-again = &Moenie my weer vra nie
dom-slow-script-dialog-stop-button = Stop skrip
dom-slow-script-dialog-continue-button = Gaan voort
