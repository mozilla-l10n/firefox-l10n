## Unresponsive script dialog

# The & character marks the access key of the checkbox label.
dom-slow-script-dialog-dont-ask-again = &Ur y-id sutur ara tikelt nniḍen
dom-slow-script-dialog-stop-button = Ṛken askript
dom-slow-script-dialog-continue-button = Kemmel
# Variables:
#   $extensionName (String) - Name of the extension running the script.
dom-slow-addon-script-dialog-message =
    Askript sγur azegrir “{ $extensionName }” atan iteddu deg usebter, daɣ atan iggar tiririt { -brand-short-name }.
    
    izmer ahat ur yelli ara akka tura, neɣ yensa di lawan-a. tzemreḍ ad tsenseḍ askript s wudem izgan, neɣ ad tkemleḍ akken ad twaliḍ ma yemmed.
dom-slow-addon-script-dialog-checkbox = Ad isewḥhel askript n uzegrir akken ad yeddu deg usebter armi d usali i d-iteddun
