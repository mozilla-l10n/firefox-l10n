protocolhandler-mailto-os-handler-yes-button = Sbadu-t d amezwer
protocolhandler-mailto-os-handler-no-button = Mačči tura
# Variables:
#  $host (String): The domain of the web application registering as a protocol handler.
#  $protocol (String): The type of protocol (e.g. "web+example").
protocolhandler-add-handler-message = Rnu “{ $host }” am usnas i yiseɣwan n { $protocol }?
protocolhandler-add-handler-button =
    .label = Rnu asnas
    .accesskey = A

## Variables:
##  $url (String): The url of a webmailer, but only its full domain name.

protocolhandler-mailto-handler-set = Seqdec <strong>{ -brand-short-name } i ulday n { $url }</strong> deg yal tikkelt mi ara tsiteḍ ɣef useɣwen i yettaldayen imayl-ik?
protocolhandler-mailto-handler-confirm = Seqdec <strong>{ -brand-short-name } ara yeldin { $url }</strong> deg yal tikkelt mi ara tsiteḍ ɣef useɣwen i yettaznen imaylen.
