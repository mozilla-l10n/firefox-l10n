### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

font-inspector-no-fonts-used = Ulac tisefsiyin ittuseqdacen deg uferdis-agi amiran.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = Nɣel URL
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Tummant
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Sagen

## Labels for the font editor controls

font-inspector-font-size-label = Teɣzi
font-inspector-font-weight-label = Taẓayt
font-inspector-font-italic-label = Uknan
font-inspector-line-height-label = Teɣzi n izirig

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Sken ugar
font-inspector-show-less = Sken drus

##

font-inspector-all-fonts-on-page-header = Akk tisefsiyin deg usebter
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Tasefsit ittwasqedcen
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Aḍris n teskant n tsefsit

