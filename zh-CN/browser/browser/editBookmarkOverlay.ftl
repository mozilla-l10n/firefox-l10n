bookmark-properties-title-edit-bookmark = 编辑书签
bookmark-properties-title-edit-folder = 编辑书签文件夹

## Default names for newly created bookmarks and folders.

# Default name of the folder created when bookmarking all tabs.
bookmark-properties-default-name-all-tabs-folder = [文件夹名称]
bookmark-properties-default-name-folder = 新建文件夹
bookmark-properties-default-name-bookmark = 新建书签
