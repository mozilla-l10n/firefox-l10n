appmenu-tab-hide-controlled =
    .buttonlabel = İlmeklerni Gizli Tut
    .buttonaccesskey = T
    .label = Gizli İlmekleriñizge İrişiñiz
    .secondarybuttonlabel = Eklentini Naqabilleştir
    .secondarybuttonaccesskey = b

## Descriptions of the doorhangers shown when an extension changes a setting.
## The <img data-l10n-name="addon-icon"/> element is the icon of the extension.
## Variables:
##   $addonName (String): name of the extension.

appmenu-new-tab-controlled-message = Bir uzantı, <img data-l10n-name="addon-icon"/> { $addonName }, yañı bir ilmek açqanıñızda körgeniñiz saifeni deñiştirdi.
appmenu-homepage-controlled-message = Bir uzantı, <img data-l10n-name="addon-icon"/> { $addonName }, ev saifesini ve yañı pencerelerni açqanıñızda ne körgeniñizni deñiştirdi.
# The <img data-l10n-name="all-tabs-icon"/> element is the icon of the all tabs button.
appmenu-tab-hide-controlled-message = Bir uzantı, <img data-l10n-name="addon-icon"/> { $addonName }, ilmekleriñizniñ bazılarını gizley. Episi ilmekleriñizge kene de <img data-l10n-name="all-tabs-icon"/> qullanaraq irişebilirsiñiz.
