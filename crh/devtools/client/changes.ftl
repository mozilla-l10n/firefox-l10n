### These strings are used in the Changes panel, accessible from the Inspector
### sidebar.


## Displayed when no changes have been made yet.

changes-no-changes = İç bir deñişiklik tapılmadı.
changes-no-changes-description = Müfettişte yapılğan CSS deñişiklikleri mında körünecektir.

##

# Displayed in place of a stylesheet file name, above changes made to the
# style attribute of an element.
changes-element-style-label = Unsur
# Badge displayed next to the source of changes made inside an iframe.
# Lowercase intentional.
changes-iframe-label = iframe
changes-copy-all-changes-button = Episi Deñişikliklerni Kopiyala
changes-copy-all-changes-button-title = Episi CSS deñişiklikleriniñ bir listesini tüyreme-tahtasına kopiyala
changes-copy-rule-button = Qaideni Kopiyala
changes-copy-rule-button-title = Bu CSS qaidesiniñ muhtevasını tüyreme-tahtasına kopiyala.

## Changes panel context menu

changes-context-menu-copy =
    .label = Kopiyala
    .accesskey = o
# Copies the complete contents of the CSS rule.
changes-context-menu-copy-rule =
    .label = Qaideni Kopiyala
changes-context-menu-select-all =
    .label = Episini Sayla
    .accesskey = e
