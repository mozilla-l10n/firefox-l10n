protocolhandler-mailto-os-handler-yes-button = Establecer como predeterminado
protocolhandler-mailto-os-handler-no-button = Ahora no
# Variables:
#  $host (String): The domain of the web application registering as a protocol handler.
#  $protocol (String): The type of protocol (e.g. "web+example").
protocolhandler-add-handler-message = ¿Agregar “{ $host }” como una aplicación para los enlaces de { $protocol }?
protocolhandler-add-handler-button =
    .label = Añadir aplicación
    .accesskey = A

## Variables:
##  $url (String): The url of a webmailer, but only its full domain name.

protocolhandler-mailto-handler-set = ¿Usar <strong>{ -brand-short-name } para abrir { $url }</strong> cada vez que hagas clic en un enlace que abra el correo electrónico?
protocolhandler-mailto-handler-confirm = <strong>{ -brand-short-name } abrirá { $url }</strong> cada vez que hagas clic en un enlace que envía un correo electrónico.
