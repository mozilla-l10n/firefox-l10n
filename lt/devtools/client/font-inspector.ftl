### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

# Displayed in place of the font URL when the font is installed locally on the
# system.
font-inspector-system = sisteminis
font-inspector-no-fonts-used = Esamam elementui nenaudojami jokie šriftai.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = Kopijuoti URL
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Grupė
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Pasirinktinis

## Labels for the font editor controls

font-inspector-font-size-label = Dydis
font-inspector-font-weight-label = Storis
font-inspector-font-italic-label = Kursyvas
font-inspector-letter-spacing-label = Protarpiai
font-inspector-line-height-label = Eilutės aukštis

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Rodyti daugiau
font-inspector-show-less = Rodyti mažiau

##

font-inspector-all-fonts-on-page-header = Visi tinklalapio šriftai
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Naudojami šriftai
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Šrifto peržiūros tekstas
