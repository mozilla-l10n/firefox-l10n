### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

# Displayed in place of the font URL when the font is installed locally on the
# system.
font-inspector-system = systemowa
font-inspector-no-fonts-used = Dla bieżącego elementu nie użyto żadnych czcionek.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = Kopiuj odnośnik
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Styl
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Własne

## Labels for the font editor controls

font-inspector-font-size-label = Rozmiar
font-inspector-font-weight-label = Waga i grubość
font-inspector-font-italic-label = Kursywa
font-inspector-letter-spacing-label = Odstępy
font-inspector-line-height-label = Wysokość linii

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Więcej
font-inspector-show-less = Mniej

##

font-inspector-all-fonts-on-page-header = Wszystkie czcionki
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Użyte czcionki
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = ĄbćdęŃoósŚźżz (poglądowy tekst dla czcionki)

## Labels for font metadata, displayed in the "All Fonts on Page" section.

font-inspector-font-version = Wersja:
font-inspector-font-designer = Projektant:
font-inspector-font-manufacturer = Producent:
font-inspector-font-vendor = Dostawca:
font-inspector-font-description = Opis:
font-inspector-font-license = Licencja:
font-inspector-font-license-info-url = Adres do informacji o licencji:

##

# Button displayed to expand a truncated value (e.g. Description or License).
font-inspector-show-full-text = Rozwiń
