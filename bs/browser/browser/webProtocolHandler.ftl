protocolhandler-mailto-os-handler-yes-button = Postavi kao zadano
protocolhandler-mailto-os-handler-no-button = Ne sada
# Variables:
#  $host (String): The domain of the web application registering as a protocol handler.
#  $protocol (String): The type of protocol (e.g. "web+example").
protocolhandler-add-handler-message = Dodaj “{ $host }” kao aplikaciju za { $protocol } linkove?
protocolhandler-add-handler-button =
    .label = Dodaj aplikaciju
    .accesskey = A

## Variables:
##  $url (String): The url of a webmailer, but only its full domain name.

protocolhandler-mailto-handler-set = Koristite <strong>{ -brand-short-name } za otvaranje { $url } </strong> svaki put kada kliknete na link koji otvara vaš e-mail?
protocolhandler-mailto-handler-confirm = <strong>{ -brand-short-name } će otvoriti { $url } </strong> svaki put kada kliknete na link koji šalje e-mail.

