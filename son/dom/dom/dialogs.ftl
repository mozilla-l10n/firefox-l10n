## Unresponsive script dialog

dom-slow-script-dialog-title = Yaamar: Šigira-dumoo ši tuuru
dom-slow-script-dialog-message = Šigira-dumi ga hima ka bara goy ra moɲoo woo ga, wala a ši tuuru koyne. War ga hin ka šigira-dumoo kayandi sohõda, wala war ga hin ka bisa ka dii nda šigira-dumoo timme.
# Variables:
#   $location (String) - URL of the script, followed by a colon and the line number (e.g. “https://example.com/script.js:42”). Long URLs are shortened with an ellipsis in the middle.
dom-slow-script-dialog-location = Šigira-dumi: { $location }
# The & character marks the access key of the checkbox label.
dom-slow-script-dialog-dont-ask-again = &Ma ši ay hãa koyne
dom-slow-script-dialog-stop-button = Šigira-dumoo kayandi
dom-slow-script-dialog-continue-button = Koy jine
