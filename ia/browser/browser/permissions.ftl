perm-persistent-storage-remember = Memorar iste decision
speech-recognition-model-download-header = Configurar recognition vocal?
# $sizeMB (Number) - the model download size in MB.
speech-recognition-model-download-message = { -brand-short-name } exeque le recognition vocal localmente, assi que le audio jammais lassa tu apparato. Pro configurar lo, un discargamento de ~{ $sizeMB } MB comenciara quando tu continua.
speech-recognition-model-download-allow =
    .label = Continuar
    .accesskey = C
speech-recognition-model-download-not-now =
    .label = Non ora
    .accesskey = N
speech-recognition-model-download-progress-message = Discargante le modello de recognition vocal
# Accessible name of the progress bar shown while the model downloads. The
# percentage and time remaining are rendered next to it, as text.
speech-recognition-model-download-progressbar =
    .aria-label = Progresso de discargamento del modello de recognition vocal
speech-recognition-model-download-cancel =
    .label = Cancellar
    .accesskey = C
speech-recognition-model-download-complete-message = Modello de recognition vocal discargate.
speech-recognition-model-download-failed-message = Discargamento del modello de recognition vocal fallite.
speech-recognition-model-download-ok =
    .label = OK
    .accesskey = O
