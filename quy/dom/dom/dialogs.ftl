## Unresponsive script dialog

dom-slow-script-dialog-title = Script nisqa willakuy :mana kutichisqa
dom-slow-script-dialog-message = Mayqin qatiqatikamaqmi kay rapipi qaqa kashkanman,utaq manapas kutichiyta atinmanchu.Kunan sayachiy munaspaqa ,utaq suyaypas tukukunankama.
# Variables:
#   $location (String) - URL of the script, followed by a colon and the line number (e.g. “https://example.com/script.js:42”). Long URLs are shortened with an ellipsis in the middle.
dom-slow-script-dialog-location = { $location } nisqapi qatiqatikamaq
# The & character marks the access key of the checkbox label.
dom-slow-script-dialog-dont-ask-again = & nisqa  ama kaqmanta tapuychu
dom-slow-script-dialog-stop-button = Chaykama qatiqatikamaq
dom-slow-script-dialog-continue-button = Ruwayraq astawan
