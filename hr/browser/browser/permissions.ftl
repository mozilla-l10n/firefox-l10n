perm-persistent-storage-remember = Zapamti ovu odluku
speech-recognition-model-download-header = Postaviti prepoznavanje govora?
# $sizeMB (Number) - the model download size in MB.
speech-recognition-model-download-message = { -brand-short-name } pokreće prepoznavanje govora lokalno, tako da audio snimka nikada ne napušta tvoj uređaj. Za postavljanje će preuzimanje od ~{ $sizeMB } MB započeti kada nastaviš.
speech-recognition-model-download-allow =
    .label = Nastavi
    .accesskey = N
speech-recognition-model-download-not-now =
