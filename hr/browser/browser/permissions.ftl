speech-recognition-model-download-progressbar =
    .aria-label = Napredak preuzimanja modela za prepoznavanje govora
speech-recognition-model-download-cancel =
    .label = Odustani
    .accesskey = O
speech-recognition-model-download-complete-message = Model za prepoznavanje govora je preuzet.
speech-recognition-model-download-failed-message = Preuzimanje modela za prepoznavanje govora nije uspjelo.
speech-recognition-model-download-ok =
    .label = U redu
    .accesskey = U
