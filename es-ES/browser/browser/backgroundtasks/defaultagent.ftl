default-browser-agent-task-description = La tarea Default Browser Agent verifica cuando el navegador predeterminado cambia de { -brand-short-name } a otro navegador. Si el cambio ocurre en circunstancias sospechosas, invitará al usuario a regresar a { -brand-short-name } no más de dos veces. { -brand-short-name } instala esta tarea automáticamente y se reinstala cuando { -brand-short-name } se actualiza. Para desactivar esta tarea, modifique la preferencia “default-browser-agent.enabled” en la página about:config o en la configuración “DisableDefaultBrowserAgent” de la política empresarial para { -brand-short-name }.
default-browser-notification-privacy-header-text = ¿Seguir usando { -brand-short-name }?
default-browser-notification-privacy-body-text = Su navegador predeterminado ha cambiado. Para seguir disfrutando de privacidad y protección integradas, regrese a { -brand-short-name }.
default-browser-notification-header-text = ¿Seguir usando { -brand-short-name }?
default-browser-notification-body-text = Su navegador predeterminado se cambió hace poco. Toque para restaurar { -brand-short-name } como navegador predeterminado.
default-browser-notification-yes-button-text = Sí
default-browser-notification-privacy-no-button-text = No, gracias
default-browser-notification-no-button-text = No
