## Unresponsive script dialog

dom-slow-script-dialog-title = హెచ్చరిక: స్పందించని స్క్రిప్టు
dom-slow-script-dialog-message = ఈ పేజీలో ఉన్న స్క్రిప్టు వత్తిడి గా వుండివుండవచ్చు, లేదా అది స్పందిచుట ఆగిపోయివుండవచ్చు.మీరు ఆ స్క్రిప్టును ఇప్పుడే ఆపవచ్చు, లేదా స్క్రిప్టు పూర్తవుతుందేమో చూడటానికి మీరు కొనసాగించవచ్చు.
# Variables:
#   $location (String) - URL of the script, followed by a colon and the line number (e.g. “https://example.com/script.js:42”). Long URLs are shortened with an ellipsis in the middle.
dom-slow-script-dialog-location = స్క్రిప్ట్: { $location }
# The & character marks the access key of the checkbox label.
dom-slow-script-dialog-dont-ask-again = నన్ను మళ్లీ అడగవద్దు
dom-slow-script-dialog-stop-button = స్క్రిప్టును ఆపండి
dom-slow-script-dialog-continue-button = కొనసాగించు
dom-slow-addon-script-dialog-title = హెచ్చరిక: ప్రతిస్పందించని పొడగింత స్క్రిప్టు
