### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = చిరునామా కాపీచెయ్యి
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = అభిమతం

## Labels for the font editor controls

font-inspector-font-size-label = పరిమాణఁ
font-inspector-font-weight-label = భారం
font-inspector-font-italic-label = వాలు
font-inspector-line-height-label = లైను ఎత్తు

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = ఇంకా చూపించు
font-inspector-show-less = కొన్నే చూపించు

