### These strings are used in the Changes panel, accessible from the Inspector
### sidebar.


## Displayed when no changes have been made yet.


##

changes-copy-all-changes-button = Sao chép tất cả thay đổi
changes-copy-all-changes-button-title = Sao chép danh sách tất cả các thay đổi CSS vào bộ nhớ tạm.
changes-copy-rule-button = Sao chép quy tắc
changes-copy-rule-button-title = Sao chép nội dung của quy tắc CSS này vào bộ nhớ tạm.

## Changes panel context menu

changes-context-menu-copy =
    .label = Sao chép
    .accesskey = C
# Copies the complete contents of the CSS rule.
changes-context-menu-copy-rule =
    .label = Sao chép quy tắc
# Copies the single CSS declaration that was right-clicked.
changes-context-menu-copy-declaration =
    .label = Sao chép khai báo
changes-context-menu-select-all =
    .label = Chọn tất cả
    .accesskey = A
