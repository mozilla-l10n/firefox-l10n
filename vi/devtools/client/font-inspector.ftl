### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

font-inspector-no-fonts-used = Không có phông chữ được sử dụng trên các yếu tố hiện tại.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = Sao chép URL
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Thực thể
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Tùy chọn

## Labels for the font editor controls

font-inspector-font-size-label = Kích thước
font-inspector-font-weight-label = Độ dày
font-inspector-font-italic-label = Nghiêng
font-inspector-letter-spacing-label = Khoảng cách
font-inspector-line-height-label = Chiều cao giữa các dòng

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Xem thêm
font-inspector-show-less = Xem ít hơn

##

font-inspector-all-fonts-on-page-header = Tất cả các phông chữ trên trang
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Phông chữ đã sử dụng
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Xem trước phông chữ

