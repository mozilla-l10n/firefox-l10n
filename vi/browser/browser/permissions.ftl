perm-persistent-storage-remember = Ghi nhớ quyết định này
speech-recognition-model-download-header = Thiết lập nhận diện giọng nói?
# $sizeMB (Number) - the model download size in MB.
speech-recognition-model-download-message = { -brand-short-name } thực hiện nhận dạng giọng nói cục bộ, vì vậy âm thanh không bao giờ rời khỏi thiết bị của bạn. Để thiết lập điều này, quá trình tải xuống ~{ $sizeMB } MB sẽ bắt đầu khi bạn tiếp tục.
speech-recognition-model-download-allow =
    .label = Tiếp tục
    .accesskey = c
speech-recognition-model-download-not-now =
    .label = Không phải bây giờ
    .accesskey = n
speech-recognition-model-download-progress-message = Đang tải xuống mô hình nhận diện giọng nói
# Accessible name of the progress bar shown while the model downloads. The
# percentage and time remaining are rendered next to it, as text.
speech-recognition-model-download-progressbar =
    .aria-label = Tiến độ tải xuống mô hình nhận diện giọng nói
speech-recognition-model-download-cancel =
    .label = Hủy bỏ
    .accesskey = C
speech-recognition-model-download-complete-message = Đã tải xuống mô hình nhận diện giọng nói.
speech-recognition-model-download-failed-message = Đã gặp lỗi khi tải xuống mô hình nhận diện giọng nói.
speech-recognition-model-download-ok =
    .label = OK
    .accesskey = O
