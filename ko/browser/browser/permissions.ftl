perm-persistent-storage-remember = 이 선택 기억하기
speech-recognition-model-download-header = 음성 인식을 설정하시겠습니까?
# $sizeMB (Number) - the model download size in MB.
speech-recognition-model-download-message = { -brand-short-name }는 음성 인식을 기기 자체에서 실행하므로 오디오 데이터가 기기 외부로 전송되지 않습니다. 이 기능을 설정하려면, 계속 진행 시 약 { $sizeMB }MB 크기의 다운로드가 시작됩니다.
speech-recognition-model-download-allow =
    .label = 계속
    .accesskey = C
speech-recognition-model-download-not-now =
    .label = 나중에
    .accesskey = N
speech-recognition-model-download-progress-message = 음성 인식 모델 다운로드 중
# Accessible name of the progress bar shown while the model downloads. The
# percentage and time remaining are rendered next to it, as text.
speech-recognition-model-download-progressbar =
    .aria-label = 음성 인식 모델 다운로드 진행률
speech-recognition-model-download-cancel =
    .label = 취소
    .accesskey = C
speech-recognition-model-download-complete-message = 음성 인식 모델이 다운로드되었습니다.
speech-recognition-model-download-failed-message = 음성인식 모델 다운로드에 실패하였습니다.
speech-recognition-model-download-ok =
    .label = 확인
    .accesskey = O
