### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

font-inspector-no-fonts-used = No se usaron fuentes en el elemento actual.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = Copiar URL
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Instancia
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Personalizado

## Labels for the font editor controls

font-inspector-font-size-label = Tamaño
font-inspector-font-weight-label = Peso
font-inspector-font-italic-label = Itálica
font-inspector-letter-spacing-label = Espaciado
font-inspector-line-height-label = Altura de la línea

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Mostrar más
font-inspector-show-less = Mostrar menos

##

font-inspector-all-fonts-on-page-header = Todas las fuentes en la página
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Fuentes utilizadas
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Vista previa del texto con el tipo de letra

