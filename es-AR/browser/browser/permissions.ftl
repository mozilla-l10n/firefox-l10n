perm-persistent-storage-remember = Recordar esta decisión
speech-recognition-model-download-header = ¿Configurar reconocimiento de voz?
# $sizeMB (Number) - the model download size in MB.
speech-recognition-model-download-message = { -brand-short-name } ejecuta el reconocimiento de voz localmente, por lo que el audio nunca sale del dispositivo. Para configurar esto, se iniciará una descarga de ~{ $sizeMB } MB al continuar.
speech-recognition-model-download-allow =
    .label = Continuar
    .accesskey = C
speech-recognition-model-download-not-now =
    .label = No ahora
    .accesskey = N
speech-recognition-model-download-progress-message = Descargando modelo de reconocimiento de voz
# Accessible name of the progress bar shown while the model downloads. The
# percentage and time remaining are rendered next to it, as text.
speech-recognition-model-download-progressbar =
    .aria-label = Progreso de la descarga del modelo de reconocimiento de voz
speech-recognition-model-download-cancel =
    .label = Cancelar
    .accesskey = C
speech-recognition-model-download-complete-message = Se descargó el modelo de reconocimiento de voz.
speech-recognition-model-download-failed-message = Falló la descarga del modelo de reconocimiento de voz.
speech-recognition-model-download-ok =
    .label = Aceptar
    .accesskey = A
