### These strings are used in the Changes panel, accessible from the Inspector
### sidebar.


## Displayed when no changes have been made yet.

changes-no-changes = Ягон тағирот ёфт нашуд.
changes-no-changes-description = Тағйироти воридшуда ба «CSS» дар Тафтишкунанда дар ин ҷой пайдо мешаванд.

##

# Displayed in place of a stylesheet file name, above changes made to an
# inline stylesheet (<style> element).
changes-inline-stylesheet-label = Дар як хат
# Displayed in place of a stylesheet file name, above changes made to the
# style attribute of an element.
changes-element-style-label = Унсур
# Badge displayed next to the source of changes made inside an iframe.
# Lowercase intentional.
changes-iframe-label = iframe
changes-copy-all-changes-button = Нусха бардоштани ҳамаи тағйирот
changes-copy-all-changes-button-title = Нусха бардоштани рӯйхати ҳамаи тағйироти «CSS» ба ҳофизаи муваққатӣ.
changes-copy-rule-button = Нусха бардоштани қоида
changes-copy-rule-button-title = Нусха бардоштани мундариҷаи ин қоидаи «CSS» ба ҳофизаи муваққатӣ.

## Changes panel context menu

changes-context-menu-copy =
    .label = Нусха бардоштан
    .accesskey = C
# Copies the complete contents of the CSS rule.
changes-context-menu-copy-rule =
    .label = Нусха бардоштани қоида
# Copies the single CSS declaration that was right-clicked.
changes-context-menu-copy-declaration =
    .label = Нусха бардоштани изҳорнома
changes-context-menu-select-all =
    .label = Ҳамаро интихоб кардан
    .accesskey = A
