### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

# Displayed in place of the font URL when the font is installed locally on the
# system.
font-inspector-system = низоми компютерӣ
font-inspector-no-fonts-used = Барои унсури ҷорӣ ягон шрифт истифода нашудааст.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = Нусха бардоштани нишонии URL
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Намуна
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Фармоишӣ

## Labels for the font editor controls

font-inspector-font-size-label = Андоза
font-inspector-font-weight-label = Тарҳ
font-inspector-font-italic-label = Курсив
font-inspector-letter-spacing-label = Фосила
font-inspector-line-height-label = Баландии сатр

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Бештар нишон диҳед
font-inspector-show-less = Камтар нишон додан

##

font-inspector-all-fonts-on-page-header = Ҳамаи шрифтҳо дар саҳифа
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Шрифтҳои истифодашуда
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Матни пешнамоиши шрифт

## Labels for font metadata, displayed in the "All Fonts on Page" section.

font-inspector-font-version = Силсила:
font-inspector-font-designer = Тарроҳ:
font-inspector-font-manufacturer = Истеҳсолкунанда:
font-inspector-font-vendor = Таъминкунанда:
font-inspector-font-description = Тавсиф:
font-inspector-font-license = Иҷозатнома:
font-inspector-font-license-info-url = Нишонии «URL» бо маълумот дар бораи иҷозатнома:

##

# Button displayed to expand a truncated value (e.g. Description or License).
font-inspector-show-full-text = Баркушодан
