dom-slow-script-dialog-dont-ask-again = &Don’t ask me again
dom-slow-script-dialog-stop-button = Dunikin' Script
dom-slow-script-dialog-continue-button = Gun' ne'ña an
# Variables:
#   $extensionName (String) - Name of the extension running the script.
dom-slow-addon-script-dialog-message =
    'Ngo script 'jaj sun ngàj “{ $extensionName }” nī 'iaj sunk riña pagina na, hue 'iaj  { -brand-short-name } ni na'ue na'ni.
    
    It siruhuaj ni si  Hua churn ma, àsi ma gè ngò diu nan na'ue gi'iaj sunj. Ga'uè duni'kïn' akuat script na, àsi gana'uijt da' ga'ue gi'iaj sunj.
