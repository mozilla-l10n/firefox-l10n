appmenu-tab-hide-controlled =
    .buttonlabel = Gà ngē rakïj ñanj huìi
    .buttonaccesskey = K
    .label = Gatu' riña rakïj ñanj huìi
    .secondarybuttonlabel = Si ganikaj ñu'ū' extenesiôn
    .secondarybuttonaccesskey = D

## Descriptions of the doorhangers shown when an extension changes a setting.
## The <img data-l10n-name="addon-icon"/> element is the icon of the extension.
## Variables:
##   $addonName (String): name of the extension.

appmenu-new-tab-controlled-message = 'Ngo extensiûn, <img data-l10n-name="addon-icon"/> { $addonName }, Nadunaj paginâ ni'iajt ngà na'nïnjt a'ngô rakïj ñanj.
appmenu-homepage-controlled-message = 'Ngo extensiûn, <img data-l10n-name="addon-icon"/> { $addonName }, Nadunaj sa ni'iajt nga ayi'ìt ni a'ngò riña bentâna nej.
# The <img data-l10n-name="all-tabs-icon"/> element is the icon of the all tabs button.
appmenu-tab-hide-controlled-message = 'Ngo extensiûn, <img data-l10n-name="addon-icon"/> { $addonName }, achrij huì man da'aj rakïj ñanj na'nïnjt. Sani ga'ue ni'iajt nej rakïj ñanj dan asìj riña <img data-l10n-name="all-tabs-icon"/>.
