### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

# Displayed in place of the font URL when the font is installed locally on the
# system.
font-inspector-system = سیستوم
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = لف گیری نشۊوی اینترنتی
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = سفارشی

## Labels for the font editor controls

font-inspector-font-size-label = هندا
font-inspector-font-weight-label = وزن
font-inspector-font-italic-label = خل
font-inspector-letter-spacing-label = فاسله ناهاڌن

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = نشووݩ داڌن قلوه
font-inspector-show-less = نشووݩ داڌن کمتر

##

font-inspector-all-fonts-on-page-header = پوی قلما من بلگه

## Labels for font metadata, displayed in the "All Fonts on Page" section.

font-inspector-font-version = نوسخه:
font-inspector-font-license = لایسنس:

