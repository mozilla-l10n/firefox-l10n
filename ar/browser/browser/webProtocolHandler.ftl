protocolhandler-mailto-os-handler-yes-button = اجعله المبدئي
protocolhandler-mailto-os-handler-no-button = ليس الآن
# Variables:
#  $host (String): The domain of the web application registering as a protocol handler.
#  $protocol (String): The type of protocol (e.g. "web+example").
protocolhandler-add-handler-message = أأُضيف ”{ $host }“ كتطبيق لروابط { $protocol }؟
protocolhandler-add-handler-button =
    .label = أضِف التطبيق
    .accesskey = ض

## Variables:
##  $url (String): The url of a webmailer, but only its full domain name.

protocolhandler-mailto-handler-set = استخدم <strong>{ -brand-short-name } لفتح { $url }</strong> في كل مرة تنقر فيها على رابط يفتح بريدك الإلكتروني؟
protocolhandler-mailto-handler-confirm = <strong>{ -brand-short-name } سيفتح { $url }</strong> في كل مرة تنقر فيها على رابط يرسل بريد إلكتروني.

