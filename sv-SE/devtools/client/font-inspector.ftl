### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

# Displayed in place of the font URL when the font is installed locally on the
# system.
font-inspector-system = system
font-inspector-no-fonts-used = Inga teckensnitt används i det aktuella elementet.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = Kopiera URL
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Instans
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Anpassad

## Labels for the font editor controls

font-inspector-font-size-label = Storlek
font-inspector-font-weight-label = Vikt
font-inspector-font-italic-label = Kursiv
font-inspector-letter-spacing-label = Mellanrum
font-inspector-line-height-label = Radavstånd

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Visa mer
font-inspector-show-less = Visa mindre

##

font-inspector-all-fonts-on-page-header = Alla typsnitt på sidan
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Typsnitt som används
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Förhandsvisning av teckensnitt

## Labels for font metadata, displayed in the "All Fonts on Page" section.

font-inspector-font-version = Version:
font-inspector-font-designer = Designer:
font-inspector-font-manufacturer = Tillverkare:
font-inspector-font-vendor = Leverantör:
font-inspector-font-description = Beskrivning:
font-inspector-font-license = Licens:
font-inspector-font-license-info-url = URL till licensinformation:

##

# Button displayed to expand a truncated value (e.g. Description or License).
font-inspector-show-full-text = Expandera
