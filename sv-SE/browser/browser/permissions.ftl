perm-persistent-storage-remember = Kom ihåg detta beslut
speech-recognition-model-download-header = Konfigurera taligenkänning?
# $sizeMB (Number) - the model download size in MB.
speech-recognition-model-download-message = { -brand-short-name } kör taligenkänning lokalt, så ljudet aldrig lämnar din enhet. För att konfigurera detta, startar en nedladdning på ~{ $sizeMB } MB när du fortsätter.
speech-recognition-model-download-allow =
    .label = Fortsätt
    .accesskey = F
speech-recognition-model-download-not-now =
    .label = Inte nu
    .accesskey = n
speech-recognition-model-download-progress-message = Hämtar taligenkänningsmodell
# Accessible name of the progress bar shown while the model downloads. The
# percentage and time remaining are rendered next to it, as text.
speech-recognition-model-download-progressbar =
    .aria-label = Förlopp för nedladdning av taligenkänningsmodell
speech-recognition-model-download-cancel =
    .label = Avbryt
    .accesskey = A
speech-recognition-model-download-complete-message = Taligenkänningsmodellen hämtad.
speech-recognition-model-download-failed-message = Nedladdning av taligenkänningsmodell misslyckades.
speech-recognition-model-download-ok =
    .label = OK
    .accesskey = O
