## Unresponsive script dialog

# The & character marks the access key of the checkbox label.
dom-slow-script-dialog-dont-ask-again = ഇനി ചോദിക്കരുതു്
dom-slow-script-dialog-stop-button = സ്ക്രിപ്റ്റ് നിര്‍ത്തുക
dom-slow-script-dialog-continue-button = മുമ്പോട്ടു് തുടരുക
# Variables:
#   $extensionName (String) - Name of the extension running the script.
dom-slow-addon-script-dialog-message =
    “{ $extensionName }” എന്ന എക്സ്റ്റൻഷനിൽ നിന്നുള്ള ഒരു സ്ക്രിപ്റ്റ് ഈ പേജിൽ പ്രവർത്തിക്കുന്നു, തന്മൂലം { -brand-short-name } പ്രതികരിക്കാതായിരിക്കുന്നു.
    
    ഇത് തിരക്കിലായിരിക്കാം, അല്ലെങ്കിൽ അത് ശാശ്വതമായി പ്രതികരിക്കുന്നത് അവസാനിപ്പിച്ചേക്കാം. നിങ്ങൾക്ക് ഇപ്പോൾ സ്ക്രിപ്റ്റ് നിർത്താനാകും, അല്ലെങ്കിൽ ഇത് പൂർത്തിയാകുമോ എന്നറിയുവാൻ നിങ്ങൾക്ക് തുടരുകയും ചെയ്യാം.
dom-slow-addon-script-dialog-checkbox = അടുത്തതായി റീലോഡ് ചെയ്യുന്നതുവരെ ഈ പേജിൽ പ്രവർത്തിക്കുന്നതിൽ നിന്നും എക്സ്റ്റൻഷൻ സ്ക്രിപ്റ്റിനെ തടയുക
