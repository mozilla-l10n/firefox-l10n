## Unresponsive script dialog

dom-slow-script-dialog-title = Isilumkiso: Iskripthi asiniki mpendulo
dom-slow-script-dialog-message = Isikripthi esikweli khasi sisenokuba sixakekile okanye siyekile ukuphendula. Ungasiyeka iskripthi ngoku, okanye ungaqhubeka ukuze ubone ukuba iskripthi siza kugqiba na.
# Variables:
#   $location (String) - URL of the script, followed by a colon and the line number (e.g. “https://example.com/script.js:42”). Long URLs are shortened with an ellipsis in the middle.
dom-slow-script-dialog-location = Iskripthi: { $location }
# The & character marks the access key of the checkbox label.
dom-slow-script-dialog-dont-ask-again = &Ungaphindi undibuze
dom-slow-script-dialog-stop-button = Nqumamisa iscript
dom-slow-script-dialog-continue-button = Qhuba
