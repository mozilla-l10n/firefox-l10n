### These strings are used in the Changes panel, accessible from the Inspector
### sidebar.


## Displayed when no changes have been made yet.


##

changes-copy-all-changes-button = Kopjo Krejt Ndryshimet
changes-copy-all-changes-button-title = Kopjoni në të papastër një listë të krejt ndryshimeve CSS.
changes-copy-rule-button = Kopjo Rregullin
changes-copy-rule-button-title = Kopjoni në të papastër lënën e këtij rregulli CSS.

## Changes panel context menu

changes-context-menu-copy =
    .label = Kopjoje
    .accesskey = K
# Copies the complete contents of the CSS rule.
changes-context-menu-copy-rule =
    .label = Kopjo Rregullin
# Copies the single CSS declaration that was right-clicked.
changes-context-menu-copy-declaration =
    .label = Kopjoje Pohimin
changes-context-menu-select-all =
    .label = Përzgjidhni Krejt
    .accesskey = P
