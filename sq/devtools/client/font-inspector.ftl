### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

font-inspector-no-fonts-used = Në elementin e tanishëm s’ka shkronja të përdorura.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = Kopjoji URL-në
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Instancë
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Vetjake

## Labels for the font editor controls

font-inspector-font-size-label = Madhësi
font-inspector-font-weight-label = Trashësi
font-inspector-font-italic-label = Të pjerrëta
font-inspector-letter-spacing-label = Hapësirë
font-inspector-line-height-label = Lartësi Rreshti

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Shfaq më tepër
font-inspector-show-less = Shfaq më pak

##

font-inspector-all-fonts-on-page-header = Krejt shkronjat në faqe
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Shkronja të Përdorura
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Tekst paraparjeje shkronjash

