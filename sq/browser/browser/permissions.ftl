    .aria-label = Ecuri shkarkimi modeli njohjeje të foluri
speech-recognition-model-download-cancel =
    .label = Anuloje
    .accesskey = A
speech-recognition-model-download-complete-message = Modeli i njohjes së të folurit u shkarkua.
speech-recognition-model-download-failed-message = Shkarkimi i modelit të njohjes së të folurit dështoi.
speech-recognition-model-download-ok =
    .label = OK
    .accesskey = O
