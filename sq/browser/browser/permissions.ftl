speech-recognition-model-download-message = { -brand-short-name }-i e bën lokalisht njohjen e të folurit, ndaj audioja s’ikën kurrë nga pajisja juaj. Për ta ujdisur këtë, do të fillojë një shkarkim ~{ $sizeMB } MB, kur të vazhdoni.
