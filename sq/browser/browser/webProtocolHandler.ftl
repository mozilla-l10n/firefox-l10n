protocolhandler-mailto-os-handler-yes-button = Vëre si parazgjedhje
protocolhandler-mailto-os-handler-no-button = Jo tani
# Variables:
#  $host (String): The domain of the web application registering as a protocol handler.
#  $protocol (String): The type of protocol (e.g. "web+example").
protocolhandler-add-handler-message = Të shtohet “{ $host }” si një aplikacion për lidhjet { $protocol }?
protocolhandler-add-handler-button =
    .label = Shtoni aplikacion
    .accesskey = A

## Variables:
##  $url (String): The url of a webmailer, but only its full domain name.

protocolhandler-mailto-handler-set = Të përdoret <strong>{ -brand-short-name } për hapje { $url }</strong>, sa herë që klikoni një lidhje e cila hap email-in tuaj?
protocolhandler-mailto-handler-confirm = <strong>{ -brand-short-name } do të hapë { $url }</strong>, sa herë që klikoni një lidhje e cila dërgon email.
