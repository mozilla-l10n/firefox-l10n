restart-required-title = Lyp Rinisje
restart-required-heading2 = Na ndjeni, { -brand-short-name }-i lyp një rinisje të shpejtë
restart-required-intro2 = { -brand-short-name }-it i duhet të përfundojë një përditësim. Riniseni, që të mbahen gjëra të siguruar dhe të rrjedhshme.
window-restoration-info2 = Do të rihapim krejt dritaret dhe skedat, hiq ato private.
restart-required-why-now-question = Pse tani?
restart-required-why-now-answer = Kjo mund të ndodhë kur përditësohet një tjetër profil apo instancë { -brand-short-name }, ose kur një përditësim s’mund të presë deri në rinisjen tuaj pasuese.
restart-required-more-details-heading = Më tepër hollësi
restart-required-multiple-instances-question = Pse mund të ndodhë kjo me profile të shumtë, apo me instanca të shumta { -brand-short-name }?
restart-required-multiple-instances-answer = Nëse një profil, apo një instancë përditësohet teksa një tjetër është ende hapur, e hapura mund të mbetet te një version i vjetër. Rinisja mban gjithçka në të njëjtin version.
restart-required-single-instance-question = S’përdor profile apo instanca të shumta. Pse ndodh kjo?
restart-required-single-instance-answer = { -brand-short-name }-it mund t’i duhet një rinisje, nëse një përditësim është aplikuar në prapaskenë, teksa ai është i hapur.
restart-required-single-instance-answer-2 = Kjo mund të ndodhë gjatë një sesioni të gjatë shfletimi, ose kur sistemi juaj operativ përditëson { -brand-short-name }-in. Rinisja e mban { -brand-short-name }-in të siguruar dhe në funksionim normal.
restart-required-unsaved-work-question = A mund të humb punë të paruajtur?
restart-required-unsaved-work-answer = Mundet dhe e dimë që kjo është e bezdisshme { -brand-short-name }-i do të rihapë skedat tuaja, por punë e paruajtur brenda faqesh web, fjala vjen, tekst në një formular, mund të mos rikthehet. Dritaret Private s’do të hapen, për të mbrojtur privatësinë tuaj.
restart-required-fix-question = Kjo është përnjëmend gjë e bezdisur! A po merret { -brand-short-name }-i me një ndreqje?
# Note: normally we would link to the bug here, but if the user sees this message,
# then they cannot visit a link without a restart.
restart-required-fix-answer = Po. E dimë që kjo hap telashe dhe po merremi me një ndreqje që e parandalon. Ndiqni ecurinë tonë te e meta 2072739 në Bugzilla.
restart-button-label2 = Rinise
# Expands the "More details" section below the buttons.
restart-required-see-more-button = Shihni më tepër
# Collapses the "More details" section below the buttons.
restart-required-see-less-button = Shihni më pak
restart-required-heading = Që të Vazhdoni të Përdorni { -brand-short-name }, riniseni
restart-required-intro = Ka filluar një përditësim i { -brand-short-name } në prapaskenë. Që të përfundojë përditësimi, do të duhet ta rinisni.
window-restoration-info = Dritaret dhe skedat tuaja do të rikthehen në çast, por jo ato private ama.
restart-button-label = Rinise { -brand-short-name }-in
