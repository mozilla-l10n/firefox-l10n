### These strings are used in the Changes panel, accessible from the Inspector
### sidebar.


## Displayed when no changes have been made yet.

changes-no-changes = Walang binago ng nakita.
changes-no-changes-description = Ang mga binago sa CSS sa Inspector ay magpapakita rito.

##

# Displayed in place of a stylesheet file name, above changes made to the
# style attribute of an element.
changes-element-style-label = Element
# Badge displayed next to the source of changes made inside an iframe.
# Lowercase intentional.
changes-iframe-label = iframe
changes-copy-all-changes-button = Kopyahin lahat ng pagbabago
changes-copy-all-changes-button-title = Kopyahin ang listahan ng lahat ng binago sa CSS sa clipboard.
changes-copy-rule-button = Kopyahin ang Panuntunan
changes-copy-rule-button-title = Kopyahin ang mga nilalaman ng panuntunang CSS na ito sa clipboard.

## Changes panel context menu

changes-context-menu-copy =
    .label = Kopyahin
    .accesskey = C
# Copies the complete contents of the CSS rule.
changes-context-menu-copy-rule =
    .label = Kopyahin ang Panuntunan
# Copies the single CSS declaration that was right-clicked.
changes-context-menu-copy-declaration =
    .label = Kopyahin ang Declaration
changes-context-menu-select-all =
    .label = Piliin lahat
    .accesskey = A
