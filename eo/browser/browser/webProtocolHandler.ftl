protocolhandler-mailto-os-handler-yes-button = Elekti kiel norma
protocolhandler-mailto-os-handler-no-button = Ne nun
# Variables:
#  $host (String): The domain of the web application registering as a protocol handler.
#  $protocol (String): The type of protocol (e.g. "web+example").
protocolhandler-add-handler-message = Ĉu aldoni “{ $host }” kiel programon por { $protocol } ligiloj?
protocolhandler-add-handler-button =
    .label = Aldoni programon
    .accesskey = A

## Variables:
##  $url (String): The url of a webmailer, but only its full domain name.

protocolhandler-mailto-handler-set = Ĉu uzi <strong>{ -brand-short-name } por malfermi { $url }</strong> ĉiam, kiam vi alklakas retpoŝtan ligilon?
protocolhandler-mailto-handler-confirm = <strong>{ -brand-short-name } malfermos { $url }</strong> ĉiam, kiam vi alklakas ligilon, kiu sendas retpoŝton.
