# The title of the about:translations page.
about-translations-title = Преведување во { -brand-short-name }
# The brief description of the Translations functionality on the page.
about-translations-description = Инстант преводи што ја почитуваат вашата приватност.
about-translations-learn-more-link = Дознајте повеќе
# An info message displayed if the device's hardware is not compatible with the Translations feature requirements.
about-translations-unsupported-info-message-2 =
    .heading = Преводот не е достапен на овој уред
    .message = Обидете се да се префрлите на друг уред.
# An info message displayed when translations are disabled and locked by enterprise policy.
about-translations-policy-disabled-info-message =
    .heading = Преводите не се достапни за вашата организација
    .message = Ова е политика поставена од вашиот администратор.
# An info message displayed when translations are disabled but can still be unblocked.
about-translations-feature-blocked-info-message =
    .heading = За да преведете текст, одблокирајте ја оваа функција
    .message = Се чини дека ги ажуриравте контролите со вештачка интелигенција за да ја блокирате оваа функција. Одблокирајте ја во секое време за да почнете да ја користите.
about-translations-feature-blocked-unblock-button = Одблокирај
# An error message displayed when the language list fails to load.
about-translations-language-load-error-message-2 =
    .heading = Не можеше да се вчитаат јазиците
    .message = Проверете ја вашата интернет-врска и обидете се повторно.
about-translations-language-load-error-button = Обиди се повторно
# An error message displayed when a translation request fails.
about-translations-translation-error-heading = Имаше проблем со преведувањето
about-translations-translation-error-subtext = Обиди се повторно.
about-translations-translation-error-button = Обиди се повторно
# An informational message displayed when the detected language is not supported.
# Variables:
#   $language (String) - The display name of the detected language.
about-translations-detected-language-unsupported-heading-2 = За жал сè уште не поддржуваме преводи од { $language }
about-translations-detected-language-unsupported-heading-unknown-2 = За жал, сè уште не поддржуваме преводи од овој јазик
about-translations-detected-language-unsupported-subtext = Изберете друг јазик.
# Placeholder text shown in the source-language text area when the user has not typed any text.
about-translations-input-placeholder =
    .placeholder = Додај текст за превод
# Text displayed on the source-language selector when no explicit option is selected
# and no language has been identified from the content of the source-language text area.
about-translations-detect-default-label =
    .label = Препознај јазик
# Text displayed on the source-language selector when no explicit option is selected
# and a valid language has been identified from the content of the source-language text area.
# Variables:
#   $language (string) - The localized display name of the detected language
about-translations-detect-language-label =
    .label = { $language } (препознаен)
