### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

font-inspector-no-fonts-used = Ez da letra-tiporik erabili uneko elementuan.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = Kopiatu URLa
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Instantzia
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Pertsonalizatua

## Labels for the font editor controls

font-inspector-font-size-label = Tamaina
font-inspector-font-weight-label = Pisua
font-inspector-font-italic-label = Etzana
font-inspector-letter-spacing-label = Tartekatzea
font-inspector-line-height-label = Lerroaren altuera

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Erakutsi gehiago
font-inspector-show-less = Erakutsi gutxiago

##

font-inspector-all-fonts-on-page-header = Orriko letra-tipo guztiak
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Erabilitako letra-tipoak
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Letra-tipoaren aurrebista-testua

