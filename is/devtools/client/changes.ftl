### These strings are used in the Changes panel, accessible from the Inspector
### sidebar.


## Displayed when no changes have been made yet.


##

changes-copy-all-changes-button = Afrita allar breytingar
changes-copy-all-changes-button-title = Afrita lista yfir allar breytingar CSS á klippispjald.
changes-copy-rule-button = Afrita reglu
changes-copy-rule-button-title = Afrita innihald þessarar CSS-reglu á klippispjald.

## Changes panel context menu

changes-context-menu-copy =
    .label = Afrita
    .accesskey = C
# Copies the complete contents of the CSS rule.
changes-context-menu-copy-rule =
    .label = Afrita reglu
changes-context-menu-select-all =
    .label = Velja allt
    .accesskey = A
