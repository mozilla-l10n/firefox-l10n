### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

font-inspector-no-fonts-used = Dim ffontiau'n cael eu defnyddio ar yr elfen gyfredol.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = Copïo URL
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Enghraifft
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Cyfaddas

## Labels for the font editor controls

font-inspector-font-size-label = Maint
font-inspector-font-weight-label = Pwysau
font-inspector-font-italic-label = Italig
font-inspector-letter-spacing-label = Bylchu
font-inspector-line-height-label = Uchder Llinell

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Dangos rhagor
font-inspector-show-less = Dangos llai

