## Unresponsive script dialog

# The & character marks the access key of the checkbox label.
dom-slow-script-dialog-dont-ask-again = &Peidiwch gofyn i mi eto
dom-slow-script-dialog-stop-button = Atal y sgript
dom-slow-script-dialog-continue-button = Ymlaen
# Variables:
#   $extensionName (String) - Name of the extension running the script.
dom-slow-addon-script-dialog-message =
    Mae sgript o estyniad “{ $extensionName }” yn rhedeg ar y dudalen hon ac yn gwneud { -brand-short-name } yn anymatebol.
    
    Gall ei fod yn brysur neu ei fod wedi peidio ag ymateb o gwbl. Gallwch atal y sgript nawr neu barhau a gweld a fydd yn cwblhau.
dom-slow-addon-script-dialog-checkbox = Atal estyniad y sgript rhag rhedeg ar y dudalen hon nes ei fod wedi ail lwytho
