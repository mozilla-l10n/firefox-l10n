perm-persistent-storage-remember = Запам'ятати це рішення
speech-recognition-model-download-header = Налаштувати розпізнавання мовлення?
# $sizeMB (Number) - the model download size in MB.
speech-recognition-model-download-message = { -brand-short-name } запускає розпізнавання мовлення локально, тому аудіо ніколи не покидає ваш пристрій. Після продовження налаштування цієї функції розпочнеться завантаження ~{ $sizeMB } МБ.
speech-recognition-model-download-allow =
    .label = Продовжити
    .accesskey = П
speech-recognition-model-download-not-now =
    .label = Не зараз
    .accesskey = Н
speech-recognition-model-download-progress-message = Завантаження моделі розпізнавання мовлення
# Accessible name of the progress bar shown while the model downloads. The
# percentage and time remaining are rendered next to it, as text.
speech-recognition-model-download-progressbar =
    .aria-label = Процес завантаження моделі розпізнавання мовлення
speech-recognition-model-download-cancel =
    .label = Скасувати
    .accesskey = С
speech-recognition-model-download-complete-message = Модель розпізнавання мовлення завантажено.
speech-recognition-model-download-failed-message = Не вдалося завантажити модель розпізнавання мовлення.
speech-recognition-model-download-ok =
    .label = OK
    .accesskey = O
