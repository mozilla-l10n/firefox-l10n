## Default button labels for <dialog> elements

dialog-button-accept =
    .label = ঠিক আছে
dialog-button-cancel =
    .label = বাতিল কৰক
dialog-button-disclosure =
    .label = অধিক তথ্য
    .accesskey = I

## Predefined button labels for dialogs created with nsIPrompt.confirmEx()

dialog-button-yes =
    .label = হয়
    .accesskey = Y
dialog-button-no =
    .label = নহয়
    .accesskey = N
dialog-button-save =
    .label = সংৰক্ষণ কৰক
    .accesskey = S
dialog-button-dont-save =
    .label = সংৰক্ষণ নকৰিব
    .accesskey = D
dialog-button-revert =
    .label = আগৰ অৱস্থালৈ নিয়ক
    .accesskey = R
