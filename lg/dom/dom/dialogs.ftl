## Unresponsive script dialog

dom-slow-script-dialog-title = Okulabula: Tteekindamu ekiwandiiko
dom-slow-script-dialog-message = Ekiwandiiko ku muko guno kikola kakati, oba kiyinza okuba nga kirekedde awo okola. Oyinza okugiyimiriza kati, oba okweyongerayo ollabe oba kina maliriza.
# Variables:
#   $location (String) - URL of the script, followed by a colon and the line number (e.g. “https://example.com/script.js:42”). Long URLs are shortened with an ellipsis in the middle.
dom-slow-script-dialog-location = Ekiwandiiko: { $location }
# The & character marks the access key of the checkbox label.
dom-slow-script-dialog-dont-ask-again = &Toddamu kubuuza
dom-slow-script-dialog-stop-button = Nyimiriza ekiwandiiko
