### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

font-inspector-no-fonts-used = Nincsenek betűkészletek használatban a jelenlegi elemen.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = Webcím másolása
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Példány
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Egyéni

## Labels for the font editor controls

font-inspector-font-size-label = Méret
font-inspector-font-weight-label = Súly
font-inspector-font-italic-label = Dőlt
font-inspector-letter-spacing-label = Betűköz
font-inspector-line-height-label = Sormagasság

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Több megjelenítése
font-inspector-show-less = Kevesebb megjelenítése

##

font-inspector-all-fonts-on-page-header = Összes betűkészlet az oldalon
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Használt betűkészletek
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Betűkészlet előnézeti szöveg

