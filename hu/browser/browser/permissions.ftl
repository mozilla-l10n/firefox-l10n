perm-persistent-storage-remember = A döntés megjegyzése
speech-recognition-model-download-header = Beállítja a beszédfelismerést?
# $sizeMB (Number) - the model download size in MB.
speech-recognition-model-download-message = A { -brand-short-name } helyben futtatja a beszédfelismerést, így a hang sosem hagyja el az eszközt. A beállításhoz egy ~{ $sizeMB } MB-os letöltés indul el, ha folytatja.
speech-recognition-model-download-allow =
    .label = Folytatás
    .accesskey = F
speech-recognition-model-download-not-now =
    .label = Most nem
    .accesskey = n
speech-recognition-model-download-progress-message = Beszédfelismerő modell letöltése
# Accessible name of the progress bar shown while the model downloads. The
# percentage and time remaining are rendered next to it, as text.
speech-recognition-model-download-progressbar =
    .aria-label = A beszédfelismerő modell letöltési állapota
speech-recognition-model-download-cancel =
    .label = Mégse
    .accesskey = M
speech-recognition-model-download-complete-message = Beszédfelismerő modell letöltve.
speech-recognition-model-download-failed-message = Nem sikerült letölteni a beszédfelismerő modellt.
speech-recognition-model-download-ok =
    .label = OK
    .accesskey = O
