moz-box-link-anchor =
    .title = S’ouvre dans un nouvel onglet
moz-box-link-opens-in-new-tab = S’ouvre dans un nouvel onglet
moz-box-item-reorder-handle =
    .aria-label = Réorganisez l’élément en utilisant Ctrl+Maj+Flèche haut ou Ctrl+Maj+Flèche bas
# Variables:
#   $item (string) - The label of the moz-box-item being reordered.
moz-box-item-reorder-handle-named =
    .aria-label = Réorganisez { $item } en utilisant Ctrl+Maj+Flèche haut ou Ctrl+Maj+Flèche bas

## Screen reader announcements made after an item in a reorderable list is moved.
## Variables:
##   $position (number) - The new position of the item in the list, starting at 1.
##   $total (number) - The total number of items in the list.

moz-box-group-reorder-announcement = Élément déplacé en position { $position } sur { $total }
