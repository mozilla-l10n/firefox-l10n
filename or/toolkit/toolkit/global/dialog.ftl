## Default button labels for <dialog> elements

dialog-button-accept =
    .label = ଠିକ ଅଛି
dialog-button-cancel =
    .label = ବାତିଲ କରନ୍ତୁ
dialog-button-disclosure =
    .label = ଅଧିକ ସୂଚନା
    .accesskey = I

## Predefined button labels for dialogs created with nsIPrompt.confirmEx()

dialog-button-yes =
    .label = ହଁ
    .accesskey = Y
dialog-button-no =
    .label = ନାଁ
    .accesskey = N
dialog-button-save =
    .label = ସଂରକ୍ଷଣ କରନ୍ତୁ
    .accesskey = S
dialog-button-dont-save =
    .label = ସଂରକ୍ଷଣ କରନ୍ତୁ ନାହିଁ
    .accesskey = D
dialog-button-revert =
    .label = ପ୍ରତ୍ୟାବୃତ କରନ୍ତୁ
    .accesskey = R
