## Default button labels for <dialog> elements

dialog-button-accept =
    .label = OK
dialog-button-cancel =
    .label = ပယ်​ဖျက်ပါ
dialog-button-disclosure =
    .label = ပိုမို အချက်အလက်
    .accesskey = I

## Predefined button labels for dialogs created with nsIPrompt.confirmEx()

dialog-button-yes =
    .label = လက်ခံတယ်
    .accesskey = Y
dialog-button-no =
    .label = လက်မခံဘူး
    .accesskey = N
dialog-button-save =
    .label = သိမ်းဆည်းပါ
    .accesskey = S
dialog-button-dont-save =
    .label = မသိမ်းဆည်းနဲ့
    .accesskey = n
dialog-button-revert =
    .label = ပြန်ထားပါ
    .accesskey = R
