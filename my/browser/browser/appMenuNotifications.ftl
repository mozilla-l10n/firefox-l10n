appmenu-tab-hide-controlled =
    .buttonlabel = တပ်ဗ်များကို ဆက်၍ဝှက်ထားပါ
    .buttonaccesskey = K
    .label = ဝှက်ထားသည့်တပ်ဗ်များကို အသုံးပြုရန်
    .secondarybuttonlabel = ပေါင်းထည့်ဆော့ဖ်ဝဲကို ပိတ်ပါ
    .secondarybuttonaccesskey = D

## Descriptions of the doorhangers shown when an extension changes a setting.
## The <img data-l10n-name="addon-icon"/> element is the icon of the extension.
## Variables:
##   $addonName (String): name of the extension.

appmenu-new-tab-controlled-message = ထပ်တိုးအပို, <img data-l10n-name="addon-icon"/> { $addonName } , က သင် တပ်ဗ်အသစ် ဖွင့်ချိန် တွင် မြင်ရမည့် စာမျက်နှာကို ပြောင်းလိုက်သည်။
appmenu-homepage-controlled-message = ထပ်တိုးအပို, <img data-l10n-name="addon-icon"/> { $addonName } , က သင့် ပင်မစာမျက်နှာ နှင့် ဝင်းဒိုး အသစ်ဖွင့်ချိန် မြင်ရမည့် စာမျက်နှာကို ပြောင်းလိုက်သည်။
# The <img data-l10n-name="all-tabs-icon"/> element is the icon of the all tabs button.
appmenu-tab-hide-controlled-message = ထပ်တိုးအပို, <img data-l10n-name="addon-icon"/> { $addonName }, က သင့် အချို့သောတပ်ဗ် တွေကို ဖျောက်လိုက်သည်၊ သင့်တပ်ဗ် အားလုံးကို <img data-l10n-name="all-tabs-icon"/> မှ ဆက်လုက် ရယူနိုင်သေးသည်။
