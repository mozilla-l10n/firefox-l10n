appmenu-tab-hide-controlled =
    .buttonlabel = Atstōt cilnes paslāptas
    .buttonaccesskey = A
    .label = Datikt pi paslāptōm cilnem
    .secondarybuttonlabel = Atslēgt paplašinojumu
    .secondarybuttonaccesskey = A

## Descriptions of the doorhangers shown when an extension changes a setting.
## The <img data-l10n-name="addon-icon"/> element is the icon of the extension.
## Variables:
##   $addonName (String): name of the extension.

appmenu-new-tab-controlled-message = Paplašynojums <img data-l10n-name="addon-icon"/> { $addonName } ir izmainiejs lopu, kuru tu radzi, kod attaisi jaunu cilni.
appmenu-homepage-controlled-message = Paplašynojums <img data-l10n-name="addon-icon"/> { $addonName } ir izmainiejs lopu, kuru tu radzi, kod attaisi jaunu cilni voi lūgu.
# The <img data-l10n-name="all-tabs-icon"/> element is the icon of the all tabs button.
appmenu-tab-hide-controlled-message = Paplašynojums <img data-l10n-name="addon-icon"/> { $addonName } sliep pōrs tovys cilnes. Tu vāļ vari pi jōm tikt nu <img data-l10n-name="all-tabs-icon"/>.
