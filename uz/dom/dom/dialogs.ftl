## Unresponsive script dialog

dom-slow-script-dialog-title = Diqqat: javob bermaydigan script
dom-slow-script-dialog-message = Ushbu sahifadagi yozuv band bo‘lishi yoki javob berishdan to‘xtagan bo‘lishi mumkin, Siz yozuvni hozir to‘xtatishingiz yoki agarda u to‘g‘ri bo‘lsa, ko‘rishda davom etishingiz mumkin.
# Variables:
#   $location (String) - URL of the script, followed by a colon and the line number (e.g. “https://example.com/script.js:42”). Long URLs are shortened with an ellipsis in the middle.
dom-slow-script-dialog-location = Skript: { $location }
# The & character marks the access key of the checkbox label.
dom-slow-script-dialog-dont-ask-again = &Yana so‘ralmasin
dom-slow-script-dialog-stop-button = Skriptni to‘xtatish
dom-slow-script-dialog-continue-button = Davom etish
