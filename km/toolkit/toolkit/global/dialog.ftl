## Default button labels for <dialog> elements

dialog-button-accept =
    .label = យល់ព្រម
dialog-button-cancel =
    .label = បោះបង់
dialog-button-disclosure =
    .label = ព័ត៌មាន​បន្ថែម
    .accesskey = I

## Predefined button labels for dialogs created with nsIPrompt.confirmEx()

dialog-button-yes =
    .label = បាទ/ចាស
    .accesskey = Y
dialog-button-no =
    .label = ទេ
    .accesskey = N
dialog-button-save =
    .label = រក្សា​ទុក
    .accesskey = S
dialog-button-dont-save =
    .label = កុំ​រក្សាទុក
    .accesskey = n
dialog-button-revert =
    .label = ត្រឡប់​ទៅ​ដើម​វិញ
    .accesskey = R
