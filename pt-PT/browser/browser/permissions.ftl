perm-persistent-storage-remember = Memorizar esta decisão
speech-recognition-model-download-header = Configurar o reconhecimento de voz?
# $sizeMB (Number) - the model download size in MB.
speech-recognition-model-download-message = O { -brand-short-name } executa o reconhecimento de voz localmente, para que o áudio nunca saia do seu dispositivo. Para configurar isto, uma transferência de ~{ $sizeMB } MB será iniciada quando continuar.
speech-recognition-model-download-allow =
    .label = Continuar
    .accesskey = C
speech-recognition-model-download-not-now =
    .label = Agora não
    .accesskey = N
speech-recognition-model-download-progress-message = A transferir o modelo de reconhecimento de voz
# Accessible name of the progress bar shown while the model downloads. The
# percentage and time remaining are rendered next to it, as text.
speech-recognition-model-download-progressbar =
    .aria-label = Progresso da transferência do modelo de reconhecimento de voz
speech-recognition-model-download-cancel =
    .label = Cancelar
    .accesskey = C
speech-recognition-model-download-complete-message = Modelo de reconhecimento de voz transferido.
speech-recognition-model-download-failed-message = Falha ao transferir o modelo de reconhecimento de voz.
speech-recognition-model-download-ok =
    .label = OK
    .accesskey = O
