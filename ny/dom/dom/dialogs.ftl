## Unresponsive script dialog

dom-slow-script-dialog-title = Chenjezo: Zolemba zosadalilika
dom-slow-script-dialog-message = zolemba pa tsamba ili mwina ndizotanganidwa,mwina zaima kuyankha. Mukhoza kusiya zolemba pompano, kapena mukhoza kupitiliza kuti muone ngati zolemba zingamalizike.
# Variables:
#   $location (String) - URL of the script, followed by a colon and the line number (e.g. “https://example.com/script.js:42”). Long URLs are shortened with an ellipsis in the middle.
dom-slow-script-dialog-location = Zolemba: { $location }
# The & character marks the access key of the checkbox label.
dom-slow-script-dialog-dont-ask-again = Osan&difunsanso
dom-slow-script-dialog-stop-button = Siyani zolemba
dom-slow-script-dialog-continue-button = Pitiliza
