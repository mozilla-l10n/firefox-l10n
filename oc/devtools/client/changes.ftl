### These strings are used in the Changes panel, accessible from the Inspector
### sidebar.


## Displayed when no changes have been made yet.


##

changes-copy-all-changes-button = Copiar totas las modificacions
changes-copy-all-changes-button-title = Copiar una lista de totas las modificacions CSS al pòrtapapièr.
changes-copy-rule-button = Copiar la règla
changes-copy-rule-button-title = Copiar lo contengut d’aquesta règla CSS al pòrtapapièr.

## Changes panel context menu

changes-context-menu-copy =
    .label = Copiar
    .accesskey = C
# Copies the complete contents of the CSS rule.
changes-context-menu-copy-rule =
    .label = Copiar la règla
# Copies the single CSS declaration that was right-clicked.
changes-context-menu-copy-declaration =
    .label = Copiar la declaracion
changes-context-menu-select-all =
    .label = O seleccionar tot
    .accesskey = t
