### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

font-inspector-no-fonts-used = Ағымдағы элементте ешбір қаріп қолданылмайды.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = URL көшіріп алу
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Экземпляр
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Таңдауыңызша

## Labels for the font editor controls

font-inspector-font-size-label = Өлшемі
font-inspector-font-weight-label = Салмағы
font-inspector-font-italic-label = Курсив
font-inspector-letter-spacing-label = Аралық
font-inspector-line-height-label = Жол биіктігі

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Көбірек көрсету
font-inspector-show-less = Азырақ көрсету

##

font-inspector-all-fonts-on-page-header = Парақтағы барлық қаріптер
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Пайдаланылған қаріптер
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Қаріпті алдын-ала қарау мәтіні

