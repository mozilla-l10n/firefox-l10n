# $sizeMB (Number) - the model download size in MB.
speech-recognition-model-download-message = { -brand-short-name } сөйлеуді тануды жергілікті түрде іске қосады, сондықтан аудио сіздің құрылғыңыздан ешқашан кетпейді. Мұны орнату үшін, жалғастырған кезде ~{ $sizeMB } МБ жүктеу басталады.
speech-recognition-model-download-allow =
