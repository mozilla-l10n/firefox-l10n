### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

font-inspector-no-fonts-used = Geen lettertypen op het huidige element gebruikt.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = URL kopiëren
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Instantie
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Aangepast

## Labels for the font editor controls

font-inspector-font-size-label = Grootte
font-inspector-font-weight-label = Gewicht
font-inspector-font-italic-label = Cursief
font-inspector-letter-spacing-label = Afstand
font-inspector-line-height-label = Regelhoogte

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Meer tonen
font-inspector-show-less = Minder tonen

##

font-inspector-all-fonts-on-page-header = Alle lettertypen op pagina
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Gebruikte lettertypen
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Voorbeeldtekst voor lettertype

