perm-persistent-storage-remember = Ține minte decizia
speech-recognition-model-download-header = Configurezi recunoașterea vocală?
# $sizeMB (Number) - the model download size in MB.
speech-recognition-model-download-message = { -brand-short-name } rulează local recunoașterea vocală; datele audio nu ies niciodată de pe dispozitivul tău. Pentru configurare, va începe o descărcare de ~{ $sizeMB } MB când vei continua.
speech-recognition-model-download-allow =
    .label = Continuă
    .accesskey = C
speech-recognition-model-download-not-now =
    .label = Nu acum
    .accesskey = N
speech-recognition-model-download-progress-message = Se descarcă modelul de recunoaștere vocală
# Accessible name of the progress bar shown while the model downloads. The
# percentage and time remaining are rendered next to it, as text.
speech-recognition-model-download-progressbar =
    .aria-label = Avansul descărcării modelului de recunoaștere vocală
speech-recognition-model-download-cancel =
    .label = Anulează
    .accesskey = C
speech-recognition-model-download-complete-message = Modelul de recunoaștere vocală a fost descărcat.
speech-recognition-model-download-failed-message = Descărcarea modelului de recunoaștere vocală a eșuat.
speech-recognition-model-download-ok =
    .label = OK
    .accesskey = O
