### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

font-inspector-no-fonts-used = Niciun font utilizat pe elementul actual.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = Copiază URL
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Instanță
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Personalizată

## Labels for the font editor controls

font-inspector-font-size-label = Mărime
font-inspector-font-weight-label = Greutate
font-inspector-font-italic-label = Cursiv
font-inspector-letter-spacing-label = Spațiere
font-inspector-line-height-label = Înălțime rând

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Afișează mai multe
font-inspector-show-less = Afișează mai puțin

##

font-inspector-all-fonts-on-page-header = Toate fonturile de pe pagină
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Fonturi folosite
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Text de previzualizare a fonturilor

