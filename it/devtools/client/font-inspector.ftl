### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

font-inspector-no-fonts-used = Nessun carattere utilizzato nell’elemento corrente.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = Copia URL
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Istanza
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Personalizzato

## Labels for the font editor controls

font-inspector-font-size-label = Dimensione
font-inspector-font-weight-label = Spessore
font-inspector-font-italic-label = Corsivo
font-inspector-letter-spacing-label = Spaziatura
font-inspector-line-height-label = Altezza riga

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Visualizza dettagli
font-inspector-show-less = Nascondi dettagli

##

font-inspector-all-fonts-on-page-header = Tutti i caratteri nella pagina
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Caratteri utilizzati
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Testo per anteprima caratteri

