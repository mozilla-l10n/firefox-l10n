perm-persistent-storage-remember = Ricorda questa scelta
speech-recognition-model-download-header = Configurare il riconoscimento vocale?
# $sizeMB (Number) - the model download size in MB.
speech-recognition-model-download-message = { -brand-short-name } esegue il riconoscimento vocale direttamente sul dispositivo, quindi l’audio non viene mai inviato altrove. Per configurarlo, proseguendo verrà avviato un download di ~{ $sizeMB } MB.
speech-recognition-model-download-allow =
    .label = Continua
    .accesskey = C
speech-recognition-model-download-not-now =
    .label = Non adesso
    .accesskey = N
speech-recognition-model-download-progress-message = Download del modello di riconoscimento vocale
# Accessible name of the progress bar shown while the model downloads. The
# percentage and time remaining are rendered next to it, as text.
speech-recognition-model-download-progressbar =
    .aria-label = Avanzamento del download del modello di riconoscimento vocale
speech-recognition-model-download-cancel =
    .label = Annulla
    .accesskey = A
speech-recognition-model-download-complete-message = Download del modello di riconoscimento vocale completato.
speech-recognition-model-download-failed-message = Impossibile scaricare il modello di riconoscimento vocale.
speech-recognition-model-download-ok =
    .label = OK
    .accesskey = O
