## Unresponsive script dialog

# The & character marks the access key of the checkbox label.
dom-slow-script-dialog-dont-ask-again = &Pe i penya doki
dom-slow-script-dialog-stop-button = Juk coc
dom-slow-script-dialog-continue-button = Mede
# Variables:
#   $extensionName (String) - Name of the extension running the script.
dom-slow-addon-script-dialog-message =
    Nyig coc ma i lamed “{ $extensionName }” tye ka tic i potbuk man, ka tye ka weko { -brand-short-name } pe miyo lagam.
    
    Twero bedo ni tye ki tic mapol, onyo ogiko woko miyo lagam pi matwal. Itwero juko nyig coc ne kombedi, onyo itwero mede me neno ka twero tum.
dom-slow-addon-script-dialog-checkbox = Geng nyig coc ma i lamed man me tic i potbuk man wang ma onwoyo cane
