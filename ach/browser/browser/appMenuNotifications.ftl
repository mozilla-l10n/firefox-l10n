appmenu-tab-hide-controlled =
    .buttonlabel = Gwok dirica matino ma okane
    .buttonaccesskey = K
    .label = Nong dirica matino mamegi ma okane
    .secondarybuttonlabel = Juk lamed
    .secondarybuttonaccesskey = K

## Descriptions of the doorhangers shown when an extension changes a setting.
## The <img data-l10n-name="addon-icon"/> element is the icon of the extension.
## Variables:
##   $addonName (String): name of the extension.

appmenu-new-tab-controlled-message = Lamed, <img data-l10n-name="addon-icon"/> { $addonName }, oloko potbuk ma ineno ka iyabo dirica matidi manyen.
appmenu-homepage-controlled-message = Lamed, <img data-l10n-name="addon-icon"/> { $addonName }, oloko ngo ma ineno ka iyabo potbuk me acakki mamegi ki dirica manyen.
# The <img data-l10n-name="all-tabs-icon"/> element is the icon of the all tabs button.
appmenu-tab-hide-controlled-message = Lamed, <img data-l10n-name="addon-icon"/> { $addonName }, tye kakano dirica matino ni mogo. Pud itwero nongo dirica matino ni weng ki ii <img data-l10n-name="all-tabs-icon"/>.
