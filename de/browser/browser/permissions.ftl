perm-persistent-storage-remember = Diese Entscheidung merken
speech-recognition-model-download-header = Spracherkennung einrichten?
# $sizeMB (Number) - the model download size in MB.
speech-recognition-model-download-message = { -brand-short-name } verarbeitet die Spracherkennung direkt auf Ihrem Gerät, sodass keine Audiodaten übertragen werden. Wenn Sie fortfahren, wird zur Einrichtung ein Download von etwa { $sizeMB } MB gestartet.
speech-recognition-model-download-allow =
    .label = Weiter
    .accesskey = W
speech-recognition-model-download-not-now =
    .label = Nicht jetzt
    .accesskey = N
speech-recognition-model-download-progress-message = Spracherkennungsmodell herunterladen
# Accessible name of the progress bar shown while the model downloads. The
# percentage and time remaining are rendered next to it, as text.
speech-recognition-model-download-progressbar =
    .aria-label = Downloadfortschritt des Spracherkennungsmodells
speech-recognition-model-download-cancel =
    .label = Abbrechen
    .accesskey = A
speech-recognition-model-download-complete-message = Spracherkennungsmodell wurde heruntergeladen.
speech-recognition-model-download-failed-message = Download des Spracherkennungsmodells fehlgeschlagen.
speech-recognition-model-download-ok =
    .label = OK
    .accesskey = O
