perm-persistent-storage-remember = Памятаць гэтае рашэнне
speech-recognition-model-download-header = Наладзіць распазнаванне маўлення?
# $sizeMB (Number) - the model download size in MB.
speech-recognition-model-download-message = { -brand-short-name } запускае распазнаванне маўлення лакальна, таму аўдыё ніколі не пакідае вашу прыладу. Каб наладзіць гэта, па працягу пачнецца сцягванне ~{ $sizeMB } МБ.
speech-recognition-model-download-allow =
    .label = Працягнуць
    .accesskey = П
speech-recognition-model-download-not-now =
    .label = Не зараз
    .accesskey = Н
speech-recognition-model-download-progress-message = Сцягваецца мадэль распазнавання маўлення
# Accessible name of the progress bar shown while the model downloads. The
# percentage and time remaining are rendered next to it, as text.
speech-recognition-model-download-progressbar =
    .aria-label = Прагрэс сцягвання мадэлі распазнавання маўлення
speech-recognition-model-download-cancel =
    .label = Скасаваць
    .accesskey = С
speech-recognition-model-download-complete-message = Мадэль распазнавання маўлення сцягнута.
speech-recognition-model-download-failed-message = Не ўдалося сцягнуць мадэль распазнавання маўлення.
speech-recognition-model-download-ok =
    .label = Добра
    .accesskey = Д
