### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

# Displayed in place of the font URL when the font is installed locally on the
# system.
font-inspector-system = сістэмны
font-inspector-no-fonts-used = На бягучым элеменце не выкарыстаны шрыфты.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = Капіяваць URL
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Экзэмпляр
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Уласны

## Labels for the font editor controls

font-inspector-font-size-label = Памер
font-inspector-font-weight-label = Вага
font-inspector-font-italic-label = Курсіў
font-inspector-letter-spacing-label = Інтэрвал
font-inspector-line-height-label = Вышыня радка

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Паказаць больш
font-inspector-show-less = Паказаць менш

##

font-inspector-all-fonts-on-page-header = Усе шрыфты на старонцы
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Выкарыстаныя шрыфты
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Тэкст перадпрагляду шрыфту

## Labels for font metadata, displayed in the "All Fonts on Page" section.

font-inspector-font-version = Версія:
font-inspector-font-designer = Дызайнер:
font-inspector-font-manufacturer = Вытворца:
font-inspector-font-vendor = Пастаўшчык:
font-inspector-font-description = Апісанне:
font-inspector-font-license = Ліцэнзія:
font-inspector-font-license-info-url = URL інфармацыі аб ліцэнзіі:

##

# Button displayed to expand a truncated value (e.g. Description or License).
font-inspector-show-full-text = Разгарнуць
