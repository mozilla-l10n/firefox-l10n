## Unresponsive script dialog

dom-slow-script-dialog-title = ಎಚ್ಚರಿಕೆ: ಪ್ರತುತ್ತರವಿಲ್ಲದ ಸ್ಕ್ರಿಪ್ಟ್‍
dom-slow-script-dialog-message = ಈ ಪುಟದಲ್ಲಿನ ಒಂದು ಸ್ಕ್ರಿಪ್ಟ್‍ ಬ್ಯುಸಿ ಆಗಿರಬಹುದು, ಅಥವ ಪ್ರತಿಸ್ಪಂದಿಸುವುದನ್ನು ನಿಲ್ಲಿಸಿರಬಹುದು.ನೀವು ಈಗ ಸ್ಕ್ರಿಪ್ಟನ್ನು ನಿಲ್ಲಿಸಬಹುದು, ಅಥವ  ಸ್ಕ್ರಿಪ್ಟ್‍ ಪೂರ್ಣಗೊಳ್ಳುತ್ತದೆಯೆ ಎಂದು ನೋಡಲು ಮುಂದುವರೆಯಬಹುದು.
# Variables:
#   $location (String) - URL of the script, followed by a colon and the line number (e.g. “https://example.com/script.js:42”). Long URLs are shortened with an ellipsis in the middle.
dom-slow-script-dialog-location = ಸ್ಕ್ರಿಪ್ಟ್‍: { $location }
# The & character marks the access key of the checkbox label.
dom-slow-script-dialog-dont-ask-again = ಮತ್ತೊಮ್ಮೆ ನನ್ನನ್ನು ಕೇಳಬೇಡ (&D)
dom-slow-script-dialog-stop-button = ಸ್ಕ್ರಿಪ್ಟನ್ನು ನಿಲ್ಲಿಸು
dom-slow-script-dialog-continue-button = ಮುಂದುವರೆ
dom-slow-addon-script-dialog-title = ಎಚ್ಚರಿಕೆ: ಪ್ರತುತ್ತರವಿಲ್ಲದ ಆಡ್-ಆನ್ ಸ್ಕ್ರಿಪ್ಟ್
# Variables:
#   $extensionName (String) - Name of the extension running the script.
dom-slow-addon-script-dialog-message =
    “{ $extensionName }” ವಿಸ್ತರಣೆಯ ಒಂದು ಸ್ಕ್ರಿಪ್ಟ್ ಈ ಪುಟದಲ್ಲಿ ಓಡುತ್ತಿದೆ ಮತ್ತು { -brand-short-name } ಪ್ರತಿಕ್ರಿಯಿಸದೆ ಮಾಡುವಂತೆ ಮಾಡುತ್ತಿದೆ.
    
    ಇದು ಕಾರ್ಯನಿರತವಾಗಿರಬಹುದು ಅಥವಾ ಶಾಶ್ವತವಾಗಿ ಪ್ರತಿಕ್ರಿಯಿಸುವುದನ್ನು ನಿಲ್ಲಿಸಬಹುದು. ನೀವು ಸ್ಕ್ರಿಪ್ಟ್ ಅನ್ನು ಈಗ ನಿಲ್ಲಿಸಬಹುದು, ಅಥವಾ ಅದು ಪೂರ್ಣಗೊಳ್ಳುವವರೆಗೂ ನೀವು ಮುಂದುವರಿಸಬಹುದು.
dom-slow-addon-script-dialog-checkbox = ಮುಂದಿನ ಪುಟವನ್ನು ಲೋಡ್ ಮಾಡುವವರೆಗೂ ವಿಸ್ತರಣಾ ಸ್ಕ್ರಿಪ್ಟ್ ಅನ್ನು ಈ ಪುಟದಲ್ಲಿ ಓಡದಂತೆ ತಡೆಯಿರಿ
