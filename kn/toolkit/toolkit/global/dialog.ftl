dialog-button-save =
    .label = ಉಳಿಸು
    .accesskey = S
dialog-button-dont-save =
    .label = ಉಳಿಸಬೇಡ
    .accesskey = D
dialog-button-revert =
    .label = ಮರಳಿ ಸ್ಥಾಪಿಸು
    .accesskey = R
