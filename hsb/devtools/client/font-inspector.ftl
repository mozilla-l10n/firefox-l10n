### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

# Displayed in place of the font URL when the font is installed locally on the
# system.
font-inspector-system = systemowe
font-inspector-no-fonts-used = Za aktualny element so žane pisma njewužiwaja.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = URL kopěrować
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Instanca
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Swójske

## Labels for the font editor controls

font-inspector-font-size-label = Wulkosć
font-inspector-font-weight-label = Waha
font-inspector-font-italic-label = Kursiwny
font-inspector-letter-spacing-label = Wotstup
font-inspector-line-height-label = Linkowa wysokosć

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Wjace pokazać
font-inspector-show-less = Mjenje pokazać

##

font-inspector-all-fonts-on-page-header = Wšě pisma na stronje
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Wužite pisma
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Tekst pismoweho přehlada

## Labels for font metadata, displayed in the "All Fonts on Page" section.

font-inspector-font-version = Wersija:
font-inspector-font-designer = Designer:
font-inspector-font-manufacturer = Zhotowjer:
font-inspector-font-vendor = Předawar:
font-inspector-font-description = Wopisanje:
font-inspector-font-license = Licenca:
font-inspector-font-license-info-url = URL licencnych informacijow:

##

# Button displayed to expand a truncated value (e.g. Description or License).
font-inspector-show-full-text = Pokazać
