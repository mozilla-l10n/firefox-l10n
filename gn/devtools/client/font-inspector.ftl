### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

font-inspector-no-fonts-used = Ndojeporúi teñoiha mba’eporu ag̃aguápe.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = URL mbohasarã
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Momandu’aha
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Ñemomba’epyre

## Labels for the font editor controls

font-inspector-font-size-label = Tuichakue
font-inspector-font-weight-label = Pohyikue
font-inspector-font-italic-label = Tai’yke
font-inspector-letter-spacing-label = Mbotuichave
font-inspector-line-height-label = Tairenda yvatekue

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Ehechaukave
font-inspector-show-less = Ehechauka’ive

##

font-inspector-all-fonts-on-page-header = Opaite teñoiha pe kuatiaroguépe
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Teñoiha porupyre
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Moñe’ẽrã jehecha ypy peteĩchagua tai ndive

