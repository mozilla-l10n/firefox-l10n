protocolhandler-mailto-os-handler-yes-button = Eiporu ypykuérõ
protocolhandler-mailto-os-handler-no-button = Ani ko’ág̃a
# Variables:
#  $host (String): The domain of the web application registering as a protocol handler.
#  $protocol (String): The type of protocol (e.g. "web+example").
protocolhandler-add-handler-message = ¿Embojuaju “{ $host }” tembiporu’íramo juajuha { $protocol } peg̃uarã?
protocolhandler-add-handler-button =
    .label = Embojuaju tembiporu’i
    .accesskey = A

## Variables:
##  $url (String): The url of a webmailer, but only its full domain name.

protocolhandler-mailto-handler-set = ¿Eiporu <strong>{ -brand-short-name } embojuruja hag̃ua { $url }</strong>eikutúvo juajuha ombojurujáva ñanduti veve?
protocolhandler-mailto-handler-confirm = <strong>{ -brand-short-name } ombojurujáta { $url }</strong> eikutúvo juajuha omondóva ñanduti veve.
