## Default button labels for <dialog> elements

dialog-button-accept =
    .label = OK
dialog-button-cancel =
    .label = ரத்து செய்
dialog-button-disclosure =
    .label = மேலும் தகவலுக்கு
    .accesskey = I

## Predefined button labels for dialogs created with nsIPrompt.confirmEx()

dialog-button-yes =
    .label = ஆம்
    .accesskey = Y
dialog-button-no =
    .label = இல்லை
    .accesskey = N
dialog-button-save =
    .label = சேமி
    .accesskey = S
dialog-button-dont-save =
    .label = சேமிக்காதே
    .accesskey = n
dialog-button-revert =
    .label = மீட்டமை
    .accesskey = R
