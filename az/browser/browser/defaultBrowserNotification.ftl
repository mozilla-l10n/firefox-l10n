# The question portion of the following message should have the <strong> and </strong> tags surrounding it.
default-browser-notification-message = <strong>{ -brand-short-name } əsas səyyahınız olaraq təyin edilsin?</strong> İnternetdən istifadə edərkən hər zaman sürətli, təhlükəsiz və məxfi səyahət əldə edin.
default-browser-notification-button =
    .label = Əsas təyin et
    .accesskey = Ə

## These strings are used for the default browser prompt. There are 2 variations
## depending on the operating system (Windows vs other). The checkbox label and
## secondary button are shared between the variants.

default-browser-prompt-title-pin = { -brand-short-name } əsas səyyahınız edilsin?
default-browser-prompt-message-pin = { -brand-short-name } həmişə əlinizin altında olsun — onu əsas səyyahınız edin və tapşırıqlar panelinə sabitləyin.
default-browser-prompt-message-pin-msix = { -brand-short-name } həmişə əlinizin altında olsun — onu əsas səyyahınız edin, tapşırıqlar panelinə və başlanğıc menyusuna sabitləyin.
default-browser-prompt-message-pin-mac = { -brand-short-name } həmişə əlinizin altında olsun — onu əsas səyyahınız edin və Dock-da saxlayın.
default-browser-prompt-button-primary-set = Əsas səyyah olaraq təyin et
default-browser-prompt-title-alt = { -brand-short-name } əsas səyyahınız edilsin?
default-browser-prompt-message-alt = Hər səyahət etdiyinizdə sürət, təhlükəsizlik və məxfilik əldə edin.
default-browser-prompt-button-primary-alt = Əsas səyyah təyin et
default-browser-prompt-checkbox-not-again-label = Bu mesajı bir daha göstərmə
default-browser-prompt-button-secondary = İndi yox

## Strings for a Windows native guidance notification when the user is forced to
## use Windows Settings to set the default browser. Instructions differ for
## Windows 10 and 11.

default-browser-guidance-notification-title = { -brand-short-name } səyyahını əsas etməyi tamamlayın
# Quoted text are keywords to look for in the Windows Settings app.
default-browser-guidance-notification-body-instruction-win10 =
    Addım 1: Tənzimləmələr > Standart tətbiqlər bölməsinə keçin
    Addım 2: Aşağı sürüşdürüb “Veb səyyahı” seçin
    Addım 3: { -brand-short-name } seçin və təyin edin
# Quoted text are keywords to look for in the Windows Settings app.
default-browser-guidance-notification-body-instruction-win11 =
    Addım 1: Tənzimləmələr > Standart tətbiqlər bölməsinə keçin
    Addım 2: { -brand-short-name } üçün “Standart təyin et” seçin
default-browser-guidance-notification-info-page = Mənə göstər
default-browser-guidance-notification-dismiss = Tamamlandı
default-browser-guidance-notification-v2-title = { -brand-short-name } səyyahını əsas səyyahınız etməyi tamamlayın
default-browser-guidance-notification-v2-body = Tənzimləmələrdə { -brand-short-name } üçün “Standart təyin et” seçin.
default-browser-guidance-notification-v2-title-only = Tənzimləmələrdə { -brand-short-name } səyyahını əsas səyyahınız etməyi tamamlayın
default-browser-guidance-notification-auto-trigger-title = Keçidlərinizi { -brand-short-name } ilə açın
default-browser-guidance-notification-auto-trigger-body = Tənzimləmələrdə { -brand-short-name } səyyahını əsas səyyah olaraq seçin.
