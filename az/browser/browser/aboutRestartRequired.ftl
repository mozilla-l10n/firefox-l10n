restart-required-title = Yenidən başlatmaq tələb edilir
restart-required-heading2 = Bağışlayın, { -brand-short-name } sürətli yenidən başlatma tələb edir
restart-required-intro2 = { -brand-short-name } yeniləməni tamamlamalıdır. Təhlükəsiz və rəvan işləməsi üçün yenidən başladın.
window-restoration-info2 = Məxfi olanlar istisna olmaqla, bütün pəncərələri və vərəqləri yenidən açacağıq.
restart-required-why-now-question = Niyə indi?
restart-required-why-now-answer = Bu, başqa bir { -brand-short-name } profili və ya nüsxəsi yeniləndikdə və ya yeniləmə növbəti yenidən başlatmanızı gözləyə bilmədikdə baş verə bilər.
restart-required-more-details-heading = Ətraflı məlumat
restart-required-multiple-instances-question = Niyə bu bir neçə profil və ya { -brand-short-name } nüsxəsi olduqda baş verə bilər?
restart-required-multiple-instances-answer = Əgər digəri açıq olduqda bir profil və ya nüsxə yenilənərsə, açıq olan köhnə versiyada qala bilər. Yenidən başlatmaq hər şeyi eyni versiyada saxlayır.
restart-required-single-instance-question = Mən bir neçə profil və ya nüsxə istifadə etmirəm. Niyə bu baş verir?
restart-required-single-instance-answer = { -brand-short-name } açıq olduqda arxa planda yeniləmə tətbiq olunarsa, yenidən başlatma tələb oluna bilər.
restart-required-single-instance-answer-2 = Bu, uzun səyahət seansı zamanı və ya əməliyyat sisteminiz { -brand-short-name } səyyahını yenilədikdə baş verə bilər. Yenidən başlatmaq { -brand-short-name } səyyahının təhlükəsiz və normal işləməsini təmin edir.
restart-required-unsaved-work-question = Saxlanmamış işimi itirə bilərəmmi?
restart-required-unsaved-work-answer = Ola bilər, və bunun narahatlıq yaratdığını bilirik. { -brand-short-name } vərəqlərinizi yenidən açacaq, lakin veb-səhifələrdəki saxlanmamış işlər, məsələn, formadakı mətnlər bərpa olunmaya bilər. Məxfiliyinizi qorumaq üçün Məxfi Pəncərələr yenidən açılmayacaq.
restart-required-fix-question = Bu çox narahat edicidir! { -brand-short-name } bunun həlli üzərində işləyirmi?
# Note: normally we would link to the bug here, but if the user sees this message,
# then they cannot visit a link without a restart.
restart-required-fix-answer = Bəli. Bunun mane olduğunu bilirik və bunun qarşısını almaq üçün həll üzərində işləyirik. Bugzilla xəta 2072739-da tərəqqimizi izləyin.
restart-button-label2 = Yenidən başlat
# Expands the "More details" section below the buttons.
restart-required-see-more-button = Ətraflı bax
# Collapses the "More details" section below the buttons.
restart-required-see-less-button = Daha az göstər
restart-required-heading = { -brand-short-name } İstifadəsinə Davam Etmək Üçün Yenidən Başladın
restart-required-intro = Arxa planda { -brand-short-name } yeniləməsi başladı. Yeniləməni tamamlamaq üçün yenidən başlatmalısınız.
window-restoration-info = Pəncərələriniz və vərəqləriniz tez bir zamanda bərpa olunacaq, lakin məxfi olanlar bərpa edilməyəcək.
restart-button-label = { -brand-short-name } Səyyahını Yenidən Başlat
