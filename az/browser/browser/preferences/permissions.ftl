    .title = İcazə verilən saytlar - Əlavə quraşdırılması
permissions-exceptions-addons-desc = Hansı saytların əlavə yükləyə biləcəyini seçə bilərsiniz. İcaz vermək istədiyiniz saytın tam ünvanını yazdıqdan sonra "İcazə ver"-ə klikləyin.

## Site Permissions - Autoplay

permissions-site-autoplay-window2 =
    .style = { permissions-window2.style }
    .title = Tənzimləmələr - Avtomatik Oynatma
permissions-site-autoplay-desc = Standart avtomatik oynatma tənzimləmələrinizə əməl etməyən saytları buradan idarə edə bilərsiniz.

## Site Permissions - Notifications

permissions-site-notification-window2 =
    .style = { permissions-window2.style }
    .title = Tənzimləmələr - Bildiriş İcazələri
permissions-site-notification-desc = Aşağıdakı saytlar sizə bildiriş göndərmək üçün icazə istəyiblər. Hansı saytların sizə bildiriş göndərə biləcəklərini dəqiqləşdirə bilərsiniz. Həmçinin yeni bildiriş icazəsi istəklərini əngəlləyə bilərsiz.
permissions-site-notification-disable-label =
    .label = Bildirişlər üçün icazə istəyən yeni istəkləri əngəllə
permissions-site-notification-disable-desc = Bu yuxarıda olmayan bütün saytların sizdən bildiriş göndərmə icazəsi istəmələrini əngəlləyəcək. Bildirişləri əngəlləmə bəzi sayt özəlliklərini poza bilər.
# Shown only where notifications can be delivered while the browser is closed.
permissions-site-notification-closed-delivery-label =
    .label = { -brand-short-name } qapalı olduqda veb-sayt bildirişlərinə icazə ver
# Notes that the operating system's own notification settings can still block
# notifications delivered while the browser is closed.
permissions-site-notification-closed-delivery-desc = Əməliyyat sisteminizin bildiriş tənzimləmələri də tətbiq olunur.

## Site Permissions - Location

permissions-site-location-window2 =
    .style = { permissions-window2.style }
    .title = Tənzimləmələr - Mövqe İcazələri
permissions-site-location-desc = Aşağıdakı saytlar mövqeyinizi almaq üçün icazə istəyiblər. Hansılarının mövqeyinizi ala biləcəklərini dəqiqləşdirə bilərsiniz. Həmçinin yeni mövqeyinizi öyrənmə istəklərini əngəlləyə bilərsiniz.
permissions-site-location-disable-label =
    .label = Məkanınız üçün icazə istəyən yeni istəkləri əngəllə
permissions-site-location-disable-desc = Bu yuxarıda olmayan bütün saytların mövqeyinizi istəmələrini əngəlləyəcək. Mövqeyinizi almağı əngəlləmə bəzi sayt özəlliklərini poza bilər.

## Site Permissions - Virtual Reality

permissions-site-xr-window2 =
    .style = { permissions-window2.style }
    .title = Tənzimləmələr - Virtual Reallıq İcazələri
permissions-site-xr-desc = Aşağıdakı veb-saytlar virtual reallıq cihazlarınıza giriş tələb ediblər. Hansı veb-saytların virtual reallıq cihazlarınıza daxil olmasına icazə verildiyini təyin edə bilərsiniz. Virtual reallıq cihazlarınıza daxil olmaq istəyən yeni sorğuları da əngəlləyə bilərsiniz.
permissions-site-xr-disable-label =
    .label = Virtual reallıq cihazlarınıza giriş istəyən yeni sorğuları əngəllə
permissions-site-xr-disable-desc = Bu, yuxarıda sadalanmayan hər hansı veb-saytın virtual reallıq cihazlarınıza giriş icazəsi tələb etməsinin qarşısını alacaq. Virtual reallıq cihazlarınıza girişi əngəlləmək bəzi veb-sayt xüsusiyyətlərini poza bilər.

## Site Permissions - App Links
## App links are links that a website can ask to open for you, like email
## (mailto:) links. Sites in this list are blocked from asking.

permissions-site-app-links-window =
    .style = { permissions-window2.style }
    .title = Tənzimləmələr - Tətbiq Keçidləri üçün Əngəllənmiş Saytlar
permissions-site-app-links-desc = Bu saytların e-poçt (mailto:) kimi tətbiq keçidlərini açmağı xahiş etməsi əngəllənib. Yenidən soruşmasına icazə vermək üçün saytı silin.

## Site Permissions - Camera

permissions-site-camera-window2 =
    .style = { permissions-window2.style }
    .title = Tənzimləmələr - Kamera İcazələri
permissions-site-camera-desc = Aşağıdakı saytlar kameranız üçün icazə istəyiblər. Hansılarının kameranızı işlədə biləcəklərini dəqiqləşdirə bilərsiniz. Həmçinin yeni kamera istəklərini əngəlləyə bilərsiniz.
permissions-site-camera-disable-label =
    .label = Kameranız üçün icazə istəyən yeni istəkləri əngəllə
permissions-site-camera-disable-desc = Bu yuxarıda olmayan bütün saytların kameranız üçün icazə istəmələrini əngəlləyəcək. Kameranızı işlətməyi əngəlləmə bəzi sayt özəlliklərini poza bilər.

## Site Permissions - Loopback network

permissions-site-localhost-window =
    .style = { permissions-window2.style }
    .title = Tənzimləmələr - Cihaz tətbiqləri və xidmətləri
permissions-site-localhost-desc = Bu veb-saytlar bu cihazdakı tətbiq və xidmətlərə giriş tələb ediblər. Saytların bunu etməsinə icazə verə və ya əngəlləyə bilərsiniz.
permissions-site-localhost-disable-label =
    .label = Bu cihazdakı tətbiq və xidmətlərə giriş üçün yeni sorğuları əngəllə
permissions-site-localhost-disable-desc = Bu, yuxarıda sadalanmayan hər hansı veb-saytın bu cihazdakı tətbiq və xidmətlərə giriş tələb etməsini dayandıracaq. Bunu etmək bəzi veb-sayt xüsusiyyətlərini poza bilər.

## Site Permissions - Local network

permissions-site-local-network-window =
    .style = { permissions-window2.style }
    .title = Tənzimləmələr - Yerli Şəbəkə Cihazları
permissions-site-local-network-desc = Bu veb-saytlar Wi-Fi və ya yerli şəbəkənizə qoşulmuş cihazlardakı tətbiq və xidmətlərə giriş tələb ediblər. Saytların bunu etməsinə icazə verə və ya əngəlləyə bilərsiniz.
permissions-site-local-network-disable-label =
    .label = Wi-Fi və ya yerli şəbəkənizə qoşulmuş cihazlardakı tətbiq və xidmətlərə giriş üçün yeni sorğuları əngəllə.
permissions-site-local-network-disable-desc = Bu, yuxarıda sadalanmayan hər hansı veb-saytın Wi-Fi və ya yerli şəbəkənizə qoşulmuş cihazlardakı tətbiq və xidmətlərə giriş tələb etməsini dayandıracaq. Bunu etmək bəzi veb-sayt xüsusiyyətlərini poza bilər.

