    .label = Saxla
smart-window-model-custom-save-confirmation = Model təfərrüatları saxlandı. Sınamaq üçün yeni söhbətə başlayın.
ai-window-memories-section =
    .label = Xatirələr
    .description = { -brand-short-name } xatirələr yaratmaq üçün fəaliyyətinizi öyrənə bilər. Onlar cavabları fərdiləşdirməyə kömək üçün istifadə olunur və bu cihaz daxilində saxlanılır.
ai-window-learn-from-chat-activity =
    .label = { -smart-window-brand-name } söhbətlərindən öyrən
ai-window-manage-memories-button =
    .label = Xatirələri idarə et
ai-window-manage-memories-header =
    .heading = Xatirələri idarə et
    .description = Xatirələr sizin məxfiliyinizi qorumaq üçün bu cihazda saxlanılır. Onlar { -smart-window-brand-name } istifadə etdiyiniz müddətcə gündə bir neçə dəfə yenilənir. Beləliklə, ən son fəaliyyətin əks olunması vaxt ala bilər.
ai-window-delete-all-memories-button =
    .label = Hamısını sil
ai-window-delete-all-memories-title = Bütün xatirələr silinsin?
ai-window-delete-all-memories-confirm = Sil
ai-window-delete-all-memories-cancel = Ləğv et

