ai-window-activate-link =
    .label = Başlayın
ai-window-personalize-button =
    .label = { -smart-window-brand-name } tənzimləmələri
ai-window-default-section =
    .label = Standart tənzimləmələr
smart-window-model-section =
    .label = Köməkçi modeli
    .description = Sizin üçün nəyin önəmli olmasına görə bir model seçin.
smart-window-model-radio-group =
    .aria-label = Köməkçi modeli
smart-window-model-learn-link = Modellər haqqında öyrənin

## Full name indicates the full version name of the model currently listed along with its publisher
##   $shortName (string) - The display name of the model collection
##   $model (string) - The name of the AI model
##   $ownerName (String) - The name of owner of the AI model

smart-window-model-fast =
    .label = Cəld: tez cavab verir
    .description = Model { $model } ({ $ownerName } tərəfindən)
smart-window-model-flexible =
    .label = Əsnək: əksər ehtiyaclar üçün yaxşı seçim
    .description = Model { $model } ({ $ownerName } tərəfindən)
smart-window-model-personal =
    .label = Fərdi: şəxsə uyğun cavablar
    .description = Model { $model } ({ $ownerName } tərəfindən)
smart-window-model-custom =
    .label = Özəl: öz "LLM"-ini istifadə et
smart-window-model-custom-name =
    .label = Model adı
    .placeholder = Nümunə: glm4
smart-window-model-custom-url =
    .label = Model uc nöqtəsi
