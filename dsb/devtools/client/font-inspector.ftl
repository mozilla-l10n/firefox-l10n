### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

font-inspector-no-fonts-used = Za aktualny element se žedne pisma njewužywaju.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = URL kopěrowaś
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Instanca
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Swójske

## Labels for the font editor controls

font-inspector-font-size-label = Wjelikosć
font-inspector-font-weight-label = Wažnosć
font-inspector-font-italic-label = Kursiwny
font-inspector-letter-spacing-label = Wótkłon
font-inspector-line-height-label = Smužkowa wusokosć

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Wěcej pokazaś
font-inspector-show-less = Mjenjej pokazaś

##

font-inspector-all-fonts-on-page-header = Wšykne pisma na boku
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Wužyte pisma
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Tekst pismowego pśeglěda

