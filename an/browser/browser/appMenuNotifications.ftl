appmenu-tab-hide-controlled =
    .buttonlabel = Mantener pestanyas amagadas
    .buttonaccesskey = M
    .label = Acceder a las tuyas pestanyas amagadas
    .secondarybuttonlabel = Desactivar extensión
    .secondarybuttonaccesskey = D

## Descriptions of the doorhangers shown when an extension changes a setting.
## The <img data-l10n-name="addon-icon"/> element is the icon of the extension.
## Variables:
##   $addonName (String): name of the extension.

appmenu-new-tab-controlled-message = Una extensión, <img data-l10n-name="addon-icon"/> { $addonName }, cambia la pachina que veyes quan s'ubre una nueva finestra.
appmenu-homepage-controlled-message = Una extensión, <img data-l10n-name="addon-icon"/> { $addonName }, cambia lo que veyer quan ubres la tuya pachina d'inicio y una nueva finestra.
# The <img data-l10n-name="all-tabs-icon"/> element is the icon of the all tabs button.
appmenu-tab-hide-controlled-message = Una extensión, <img data-l10n-name="addon-icon"/> { $addonName }, ye amagando belunas d'as tuyas pestanyas. Encara puetz veyer-las dende <img data-l10n-name="all-tabs-icon"/>.
