### These strings are used in the Changes panel, accessible from the Inspector
### sidebar.


## Displayed when no changes have been made yet.


##

changes-copy-all-changes-button = Kopírovat všechny změny
changes-copy-all-changes-button-title = Kopírovat seznam všech změn v CSS do schránky.
changes-copy-rule-button = Kopírovat pravidlo
changes-copy-rule-button-title = Kopírovat obsah tohoto CSS pravidla do schránky.

## Changes panel context menu

changes-context-menu-copy =
    .label = Kopírovat
    .accesskey = K
# Copies the complete contents of the CSS rule.
changes-context-menu-copy-rule =
    .label = Kopírovat pravidlo
# Copies the single CSS declaration that was right-clicked.
changes-context-menu-copy-declaration =
    .label = Kopírovat deklaraci
changes-context-menu-select-all =
    .label = Vybrat vše
    .accesskey = A
