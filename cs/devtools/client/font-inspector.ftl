### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

# Displayed in place of the font URL when the font is installed locally on the
# system.
font-inspector-system = systémový
font-inspector-no-fonts-used = Pro aktuální prvek není použit žádný font.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = Zkopírovat URL
# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Instance
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Vlastní

## Labels for the font editor controls

font-inspector-font-size-label = Velikost
font-inspector-font-weight-label = Tloušťka
font-inspector-font-italic-label = Kurzíva
font-inspector-letter-spacing-label = Rozestupy
font-inspector-line-height-label = Výška řádku

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Zobrazit víc
font-inspector-show-less = Zobrazit méně

##

font-inspector-all-fonts-on-page-header = Všechna písma na stránce
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Použitá písma
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Text pro náhled písma

## Labels for font metadata, displayed in the "All Fonts on Page" section.

font-inspector-font-version = Verze:
font-inspector-font-designer = Designér:
font-inspector-font-manufacturer = Výrobce:
font-inspector-font-vendor = Autor:
font-inspector-font-description = Popis:
font-inspector-font-license = Licence:
font-inspector-font-license-info-url = Adresa URL s informacemi o licenci:

##

# Button displayed to expand a truncated value (e.g. Description or License).
font-inspector-show-full-text = Rozbalit
