moz-box-link-anchor =
    .title = Otevře se v novém panelu
moz-box-link-opens-in-new-tab = Otevře se v novém panelu
moz-box-item-reorder-handle =
    .aria-label = Uspořádání položek změníte stisknutím Ctrl+Shift+Šipka nahoru nebo Ctrl+Shift+Šipka dolu
# Variables:
#   $item (string) - The label of the moz-box-item being reordered.
moz-box-item-reorder-handle-named =
    .aria-label = Uspořádání { $item } změníte stisknutím Ctrl+Shift+Šipka nahoru nebo Ctrl+Shift+Šipka dolu

## Screen reader announcements made after an item in a reorderable list is moved.
## Variables:
##   $position (number) - The new position of the item in the list, starting at 1.
##   $total (number) - The total number of items in the list.

moz-box-group-reorder-announcement = Položka přesunuta na { $position }. pozici z { $total }
