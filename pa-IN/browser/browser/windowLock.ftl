## Lock screen covering Private Windows after the computer locks, goes to
## sleep or starts the screen saver, or after the user presses the shortcut to
## lock windows.

window-lock-private-title = ਪ੍ਰਾਈਵੇਟ ਵਿੰਡੋਆਂ ਲਾਕ ਹਨ
window-lock-private-description-macos = ਤੁਹਾਡੇ ਕੰਪਿਊਟਰ ਦੇ ਲਾਕ ਹੋਣ, ਸਲੀਪ ਹੋਣ ਜਾਂ ਸਕਰੀਨ-ਸੇਵਰ ਚੱਲਣ ਦੇ ਬਾਅਦ { -brand-short-name } ਤੁਹਾਡੇ ਪ੍ਰਾਈਵੇਟ ਸਫ਼ਿਆਂ ਨੂੰ ਲੁਕਾਉਂਦਾ ਹੈ।
window-lock-private-description-windows = ਜਦੋਂ ਤੁਹਾਡਾ ਕੰਪਿਊਟਰ ਲਾਕ ਹੁੰਦਾ ਹੈ ਤਾਂ { -brand-short-name } ਤੁਹਾਡੇ ਪ੍ਰਾਈਵੇਟ ਸਫ਼ਿਆਂ ਨੂੰ ਲੁਕਾਉਂਦਾ ਹੈ।
window-lock-unlock-button =
    .label = ਅਣ-ਲਾਕ ਕਰੋ
# Shown on the lock screen when the operating system authentication prompt failed with an error.
window-lock-auth-error =
    .message = ਤੁਹਾਡੀ ਪਛਾਣ ਦੀ ਜਾਂਚ ਨਹੀਂ ਕੀਤੀ ਜਾ ਸਕੀ। ਫ਼ੇਰ ਕੋਸ਼ਿਸ਼ ਕਰੋ।
# Title of the Windows authentication prompt when unlocking browser windows.
window-lock-os-auth-dialog-caption = { -brand-full-name }
# This message is shown in the Windows authentication prompt when unlocking Private Windows.
window-lock-private-os-auth-dialog-message-win = ਆਪਣੀਆਂ ਪ੍ਰਾਈਵੇਟ ਵਿੰਡੋਆਂ ਨੂੰ ਅਣ-ਲਾਕ ਕਰਨ ਵਾਸਤੇ ਆਪਣੇ Windows ਸਾਈਨ-ਇਨ ਵੇਰਵੇ ਦਿਓ ਤਾਂ ਕਿ ਤਸਦੀਕ ਕੀਤਾ ਜਾ ਸਕੇ ਕਿ ਇਹ ਤੁਸੀਂ ਹੀ ਹੋ।
# This message is shown in the macOS authentication prompt when unlocking Private Windows.
# On macOS, only provide the reason that account verification is needed. Do not put a complete sentence here
# (the system adds “Firefox is trying to…” before it).
window-lock-private-os-auth-dialog-message-macosx = ਆਪਣੀਆਂ ਪ੍ਰਾਈਵੇਟ ਵਿੰਡੋਆਂ ਨੂੰ ਅਣ-ਲਾਕ ਕਰੋ
