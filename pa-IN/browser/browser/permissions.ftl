perm-persistent-storage-remember = ਇਸ ਫ਼ੈਸਲਾ ਨੂੰ ਯਾਦ ਰੱਖੋ
speech-recognition-model-download-header = ਬੋਲੀ ਪਛਾਣ ਨੂੰ ਸੈੱਟ ਅੱਪ ਕਰਨਾ ਹੈ?
# $sizeMB (Number) - the model download size in MB.
speech-recognition-model-download-message = { -brand-short-name } ਬੋਲੀ ਪਛਾਣ ਨੂੰ ਲੋਕਲ ਰੂਪ ਵਿੱਚ ਚਲਾਉਂਦਾ ਹੈ ਤਾਂ ਕਿ ਆਡੀਓ ਕਦੇ ਵੀ ਤੁਹਾਡੇ ਡਿਵਾਈਸ ਤੋਂ ਬਾਹਰ ਨਾਲ ਭੇਜੀ ਜਾਵੇ। ਇਸ ਨੂੰ ਸੈਟਅੱਪ ਕਰਨ ਲਈ ਜਦੋਂ ਵੀ ਤੁਸੀਂ ਜਾਰੀ ਰੱਖਿਆ ਤਾਂ ~{ $sizeMB } MB ਡਾਊਨਲੋਡ ਸ਼ੁਰੂ ਕੀਤਾ ਜਾਵੇਗਾ।
speech-recognition-model-download-allow =
    .label = ਜਾਰੀ ਰੱਖੋ
    .accesskey = C
speech-recognition-model-download-not-now =
    .label = ਹੁਣੇ ਨਹੀਂ
    .accesskey = N
speech-recognition-model-download-progress-message = ਬੋਲੀ ਪਛਾਣ ਮਾਡਲ ਨੂੰ ਡਾਊਨਲੋਡ ਕੀਤਾ ਜਾ ਰਿਹਾ ਹੈ
# Accessible name of the progress bar shown while the model downloads. The
# percentage and time remaining are rendered next to it, as text.
speech-recognition-model-download-progressbar =
    .aria-label = ਬੋਲੀ ਪਛਾਣ ਮਾਡਲ ਡਾਊਨਲੋਡ ਸਥਿਤੀ
speech-recognition-model-download-cancel =
    .label = ਰੱਦ ਕਰੋ
    .accesskey = C
speech-recognition-model-download-complete-message = ਬੋਲੀ ਪਛਾਣ ਮਾਡਲ ਡਾਊਨਲੋਡ ਕੀਤੇ।
speech-recognition-model-download-failed-message = ਬੋਲੀ ਪਛਾਣ ਮਾਡਲ ਡਾਊਨਲੋਡ ਕਰਨੇ ਫੇਲ੍ਹ।
speech-recognition-model-download-ok =
    .label = ਠੀਕ ਹੈ
    .accesskey = O
