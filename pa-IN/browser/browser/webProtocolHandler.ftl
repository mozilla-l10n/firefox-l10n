protocolhandler-mailto-os-handler-yes-button = ਮੂਲ ਵਜੋਂ ਸੈੱਟ ਕਰੋ
protocolhandler-mailto-os-handler-no-button = ਹੁਣੇ ਨਹੀਂ
# Button in the notification bar shown when a website asks to register as an
# application handler, for example for email links. Blocks the website from
# asking again.
protocolhandler-never-allow-button =
    .label = ਕਦੇ ਵੀ ਇਜਾਜ਼ਤ ਨਾ ਦਿਓ
    .accesskey = N
# Variables:
#  $host (String): The domain of the web application registering as a protocol handler.
#  $protocol (String): The type of protocol (e.g. "web+example").
protocolhandler-add-handler-message = “{ $host }” ਨੂੰ { $protocol } ਲਿੰਕ ਲਈ ਐਪਲੀਕੇਸ਼ਨ ਵਜੋਂ ਜੋੜਨਾ ਹੈ?
protocolhandler-add-handler-button =
    .label = ਐਪਲੀਕੇਸ਼ਨ ਸ਼ਾਮਲ
    .accesskey = A

## Variables:
##  $url (String): The url of a webmailer, but only its full domain name.

protocolhandler-mailto-handler-set = ਜਦੋਂ ਵੀ ਤੁਹਾਡੀ ਈਮੇਲ ਨੂੰ ਖੋਲ੍ਹਣ ਵਾਲੇ ਲਿੰਕ ਨੂੰ ਤੁਸੀਂ ਕਲਿੱਕ ਕਰਦੇ ਹੋ ਤਾਂ ਹਰ ਵਾਰ <strong>{ $url } ਨੂੰ { -brand-short-name } ਨਾਲ ਖੋਲ੍ਹਣਾ </strong> ਹੈ?
protocolhandler-mailto-handler-confirm = ਜਦੋਂ ਵੀ ਤੁਸੀਂ ਈਮੇਲ ਨੂੰ ਭੇਜਣ ਵਾਲਾ ਲਿੰਕ ਨੂੰ ਕਲਿੱਕ ਕਰਦੇ ਹੋ ਤਾਂ <strong>{ -brand-short-name } ਹਰ ਵਾਰ { $url } ਨੂੰ ਨੂੰ ਖੋਲ੍ਹੇਗਾ</strong>।
