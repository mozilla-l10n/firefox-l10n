## Default button labels for <dialog> elements


## Predefined button labels for dialogs created with nsIPrompt.confirmEx()

dialog-button-yes =
    .label = ਹਾਂ
    .accesskey = Y
dialog-button-no =
    .label = ਨਹੀਂ
    .accesskey = N
dialog-button-save =
    .label = ਸੰਭਾਲੋ
    .accesskey = S
dialog-button-dont-save =
    .label = ਨਾ ਸੰਭਾਲੋ
    .accesskey = D
dialog-button-revert =
    .label = ਵਾਪਸ ਲਵੋ
    .accesskey = R
