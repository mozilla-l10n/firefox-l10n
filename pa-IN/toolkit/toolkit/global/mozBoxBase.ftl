moz-box-link-anchor =
    .title = ਨਵੇਂ ਟੈਬ ਵਿੱਚ ਖੋਲ੍ਹਦਾ ਹੈ
moz-box-link-opens-in-new-tab = ਨਵੇਂ ਟੈਬ ਵਿੱਚ ਖੋਲ੍ਹਦਾ ਹੈ
moz-box-item-reorder-handle =
    .aria-label = Ctrl+Shift+ArrowUp ਜਾਂ Ctrl+Shift+ArrowDown ਵਰਤ ਕੇ ਚੀਜ਼ਾਂ ਦਾ ਕ੍ਰਮ ਬਦਲੋ
# Variables:
#   $item (string) - The label of the moz-box-item being reordered.
moz-box-item-reorder-handle-named =
    .aria-label = Ctrl+Shift+ArrowUp ਜਾਂ Ctrl+Shift+ArrowDown ਵਰਤ ਕੇ { $item } ਦਾ ਕ੍ਰਮ ਬਦਲੋ

## Screen reader announcements made after an item in a reorderable list is moved.
## Variables:
##   $position (number) - The new position of the item in the list, starting at 1.
##   $total (number) - The total number of items in the list.

moz-box-group-reorder-announcement = ਚੀਜ਼ ਨੂੰ { $total } ਦੇ { $position } ਉੱਤੇ ਭੇਜਿਆ ਗਿਆ
