### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

# Displayed in place of the font URL when the font is installed locally on the
# system.
font-inspector-system = ਸਿਸਟਮ
font-inspector-no-fonts-used = ਮੌਜੂਦਾ ਤੱਤ 'ਤੇ ਕੋਈ ਫ਼ੌਂਟ ਨਹੀਂ ਵਰਤਿਆ ਗਿਆ।
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = URL ਕਾਪੀ ਕਰੋ
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = ਕਸਟਮ

## Labels for the font editor controls

font-inspector-font-size-label = ਅਕਾਰ
font-inspector-font-weight-label = ਭਾਰ
font-inspector-font-italic-label = ਇਟਾਲਿਕ
font-inspector-letter-spacing-label = ਖਾਲੀ ਥਾਂ
font-inspector-line-height-label = ਲਾਈਨ ਉਚਾਈ

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = ਹੋਰ ਦਿਖਾਓ
font-inspector-show-less = ਘੱਟ ਦਿਖਾਓ

