password-quality-meter = Imitha yekhwalithi yenomboro yokungena

## Change Password dialog

# Variables:
# $tokenName (String) - Security device of the change password dialog
change-password-token = Isisetjenziswa Sevikelo: { $tokenName }
change-password-old = Inomboro yokungena yanje:
change-password-new = Inomboro yokungena etja:
change-password-reenter = Inomboro yokungena etja (godu):
change-password-not-set =
    .value = (akukahlelwa)

## Reset Primary Password dialog

reset-password-button-label =
    .label = Hlela butjha

## Downloading cert dialog

download-cert-window2 =
    .title = Ukukhuphela Iintifikhethi
    .style = min-width: 46em
download-cert-message = Kube nesibawo sokobana uthembe Isiphathimandla esitjha Sesitifikhethi (CA).
# Variables:
#   $caName (string) - The name of the Certificate Authority
download-cert-trust-header = Ufuna ukuthemba "{ $caName }" mayelana nehloso elandelako?
# Used as $caName in download-cert-trust-header when the Certificate Authority has no name
download-cert-unnamed-ca = Isiphathi-mandla Sesitifikhethi (asinagama)
download-cert-trust-ssl =
    .label = Themba CA le ukubona ama-web sites.
download-cert-trust-email =
    .label = Themba CA le ukubona abasebenzisi be-email.
download-cert-message-desc = Ngaphambili kokuthemba CA le mayelana nayiphi ihloso, kufanele uqalisise isitifikhethi sayo nemigomo nekambiso yayo (nakube kuyakghoneka).
download-cert-view-cert =
    .label = Bona
download-cert-view-text = Qalisisa Iintifikhethi zeCA

## Client Authentication Ask dialog

client-auth-window =
    .title = Isibawo sokwazisa umsebenzisi
client-auth-cert-details = Imininingwane yesitifikhethi esikhethiweko:

## Set password (p12) dialog

set-password-window =
    .title = Khetha inomboro yokungena yesitifikhethi esisisekelo
set-password-message = Inomboro yokungena yesitifikhethi esisisekelo oyifake la ivikela ifayili elisisekelo oseduze nokulakha.  Kufanele uhlele inomboro le yokungena ukuragela phambili nesekelo.
set-password-backup-pw =
    .value = Inomboro yokungena yesisekelo sesitifikhethi:
set-password-repeat-backup-pw =
    .value = Inomboro yokungena yesisekelo sesitifikhethi (godu):
set-password-reminder = Kuqakathekile: Nakube uyalibala inomboro yokungena yesisekelo sesitifikhethi, angeze ukwazi ukuvuselela isisekelwesi esikhathi esizako.  Sibawa uyitlole endaweni ebulungekileko.

